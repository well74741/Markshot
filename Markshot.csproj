<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Markshot</RootNamespace>
    <AssemblyName>Markshot</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\markshot.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Patch releases count in two digits from 0.8.01 on (display version);
         the numeric Windows version fields carry 0.8.1.0. -->
    <Version>0.8.72</Version>
    <InformationalVersion>0.8.72</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Markshot</Product>
    <Company>guoqing.wu</Company>
    <Authors>guoqing.wu (well74741)</Authors>
    <Copyright>Copyright © 2026 guoqing.wu (well74741)</Copyright>
    <Description>Markshot — 截图、批注、贴图、本地 OCR 与原位翻译</Description>
    <AssemblyVersion>0.8.72.0</AssemblyVersion>
    <FileVersion>0.8.72.0</FileVersion>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test runner is its own project (tests\Markshot.Tests). -->
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\*.png" />
    <Resource Include="Assets\markshot.ico" />
    <Resource Include="Assets\markshot_dark.ico" />
    <Resource Include="Assets\donate_qr.png" />
    <Resource Include="Assets\donate_qr_light.png" />
    <Resource Include="Assets\donate_qr_wechat.png" />
    <Resource Include="Assets\donate_qr_wechat_light.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
    <!-- 录屏: system sound (WASAPI loopback) and microphone capture (MIT). -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <!-- 二维码: zxing-cpp. Its native ZXing.dll has the same file name as ZXing.Net's zxing.dll (Windows ignores case), so it
         is shipped as zxingcpp-native.dll and loaded by name (CodeReader). -->
    <PackageReference Include="ZXingCpp" Version="0.5.3" ExcludeAssets="native" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- PP-OCRv5 Chinese recognizer + dictionary (Apache-2.0). The detector,
         classifier and Latin recognizer come from the RapidOcrNet package.
         OcrService loads models from <exe dir>\models\v5, so they must stay
         out of the single-file bundle. -->
    <Content Include="models\v5\ch_PP-OCRv5_rec_mobile.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="models\v5\ppocrv5_dict.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 帮助: one web page (tools\make_help.py builds it), opened from the tray menu and the settings window's "?". -->
    <Content Include="help\index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('tools\deps\ffmpeg\ffmpeg.exe')">
    <!-- 录屏 encodes / exports with ffmpeg (GPL v3, run as a separate program). tools\get_ffmpeg.ps1
         puts it into tools\deps\ffmpeg; it ships as ffmpeg\ffmpeg.exe next to Markshot.exe. -->
    <Content Include="tools\deps\ffmpeg\ffmpeg.exe;tools\deps\ffmpeg\ffmpeg.exe.LICENSE;tools\deps\ffmpeg\ffmpeg.exe.README">
      <Link>ffmpeg\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgZXingCpp)/runtimes/win-x64/native/ZXing.dll" Link="zxingcpp-native.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
