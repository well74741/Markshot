<!-- 录屏 — from SketchPlayer: the recorder toolbar, ported from the author's SketchPlayer project. -->
<Window x:Class="Markshot.UI.Recording.RecordBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rec="clr-namespace:Markshot.UI.Recording"
        Title="Markshot 录屏"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="True"
        Topmost="True"
        Background="#FF1C1C1C"
        UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI"
        Foreground="{StaticResource TextPrimary}">
    <Window.Resources>
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8D8D8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 开始 / 停止: a red record button. -->
        <Style x:Key="RecButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#33FF4D4F" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FF4D4F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderBrush="#33FFFFFF" BorderThickness="1" Background="#FF1C1C1C"
            MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseMove="Root_MouseMove" MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <StackPanel>
            <!-- ===== before / while recording ===== -->
            <StackPanel x:Name="RecordRow" Orientation="Horizontal" Margin="6,4">
                <Ellipse x:Name="RecDot" Width="8" Height="8" Fill="#7A7A7A" Margin="4,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TimeText" Text="00:00" Style="{StaticResource BarText}" FontFamily="Consolas" FontSize="13" MinWidth="44" />
                <Border Style="{StaticResource Sep}" />
                <StackPanel x:Name="SetupGroup" Orientation="Horizontal">
                    <Button x:Name="FpsButton" Style="{StaticResource ToolButton}" Height="30" Click="Fps_Click" ToolTip="帧率" />
                    <Border Style="{StaticResource Sep}" />
                    <TextBox x:Name="WidthBox" Style="{StaticResource SizeLabelField}" FontSize="12.5" Width="40" TextAlignment="Center"
                             ToolTip="宽（像素），Enter 应用" PreviewKeyDown="SizeBox_PreviewKeyDown" LostKeyboardFocus="SizeBox_LostFocus" />
                    <TextBlock Text="×" Style="{StaticResource BarText}" Margin="2,0" />
                    <TextBox x:Name="HeightBox" Style="{StaticResource SizeLabelField}" FontSize="12.5" Width="40" TextAlignment="Center"
                             ToolTip="高（像素），Enter 应用" PreviewKeyDown="SizeBox_PreviewKeyDown" LostKeyboardFocus="SizeBox_LostFocus" />
                    <Button Style="{StaticResource ChevronButton}" Click="SizePresets_Click" ToolTip="常用尺寸">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevron}" Width="10" Height="10" />
                    </Button>
                    <Border Style="{StaticResource Sep}" />
                    <ToggleButton x:Name="DelayToggle" Style="{StaticResource IconToolToggle}" Click="DelayToggle_Click" ToolTip="延时开始">
                        <Border Style="{StaticResource IconCountdownMask}" Width="16" Height="16" />
                    </ToggleButton>
                    <Button x:Name="DelayButton" Style="{StaticResource ToolButton}" Height="30" Padding="4,0" Click="Delay_Click" ToolTip="延时秒数" />
                    <Border Style="{StaticResource Sep}" />
                </StackPanel>
                <Button x:Name="StartButton" Style="{StaticResource RecButton}" Click="Start_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="StartGlyph" Width="10" Height="10" CornerRadius="5" Background="#FF4D4F" VerticalAlignment="Center" />
                        <TextBlock x:Name="StartText" Text="开始" Foreground="White" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="PauseToggle" Style="{StaticResource IconToolToggle}" Margin="4,0,0,0" Click="Pause_Click" ToolTip="暂停 / 继续">
                    <Border x:Name="PauseIcon" Style="{StaticResource IconPauseMask}" Width="16" Height="16" />
                </ToggleButton>
                <Border Style="{StaticResource Sep}" />
                <ToggleButton x:Name="SystemToggle" Style="{StaticResource IconToolToggle}" Click="System_Click" ToolTip="录制系统声音">
                    <Border Style="{StaticResource IconSpeakerMask}" Width="17" Height="17" />
                </ToggleButton>
                <ToggleButton x:Name="MicToggle" Style="{StaticResource IconToolToggle}" Click="Mic_Click" ToolTip="录制麦克风">
                    <Border Style="{StaticResource IconMicMask}" Width="17" Height="17" />
                </ToggleButton>
                <ToggleButton x:Name="KeysToggle" Style="{StaticResource IconToolToggle}" Click="Keys_Click" ToolTip="操作录制：在录像左下角显示按下的按键和鼠标键">
                    <Border Style="{StaticResource IconKeysMask}" Width="17" Height="17" />
                </ToggleButton>
                <Border Style="{StaticResource Sep}" />
                <Button x:Name="RetakeButton" Style="{StaticResource IconToolButton}" Click="Retake_Click" ToolTip="重录">
                    <Border Style="{StaticResource IconRetakeMask}" Width="17" Height="17" />
                </Button>
                <Button Style="{StaticResource IconToolButton}" Click="Exit_Click" ToolTip="退出录屏">
                    <Border Style="{StaticResource IconExitMask}" Width="17" Height="17" />
                </Button>
            </StackPanel>

            <!-- ===== preview after stopping ===== -->
            <StackPanel x:Name="PreviewRows" Visibility="Collapsed">
                <rec:TrimBar x:Name="Trim" Margin="8,4,8,0" />
                <StackPanel Orientation="Horizontal" Margin="6,0,6,4">
                    <Button x:Name="PlayButton" Style="{StaticResource IconToolButton}" Click="Play_Click" ToolTip="播放 / 暂停（空格）">
                        <Border x:Name="PlayIcon" Style="{StaticResource IconPlayMask}" Width="15" Height="15" />
                    </Button>
                    <TextBlock x:Name="PreviewTime" Style="{StaticResource BarText}" FontFamily="Consolas" Margin="4,0,6,0" MinWidth="96" />
                    <Border Style="{StaticResource Sep}" />
                    <Button x:Name="SpeedButton" Style="{StaticResource ToolButton}" Height="30" Click="Speed_Click" ToolTip="倍速（保存时也按这个倍速）" />
                    <ToggleButton x:Name="SoundToggle" Style="{StaticResource IconToolToggle}" Click="Sound_Click" ToolTip="声音（关闭 = 保存为无声）">
                        <Border Style="{StaticResource IconSpeakerMask}" Width="17" Height="17" />
                    </ToggleButton>
                    <Border Style="{StaticResource Sep}" />
                    <Button x:Name="SaveButton" Style="{StaticResource IconToolButton}" Click="Save_Click" ToolTip="保存 MP4 / GIF">
                        <Border Style="{StaticResource IconSaveMask}" />
                    </Button>
                    <Button x:Name="CopyButton" Style="{StaticResource IconToolButton}" Click="Copy_Click" ToolTip="复制视频文件（可直接粘贴到聊天 / 文件夹）">
                        <Border Style="{StaticResource IconCopyMask}" />
                    </Button>
                    <Border Style="{StaticResource Sep}" />
                    <Button Style="{StaticResource IconToolButton}" Click="Retake_Click" ToolTip="重录">
                        <Border Style="{StaticResource IconRetakeMask}" Width="17" Height="17" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Exit_Click" ToolTip="退出录屏">
                        <Border Style="{StaticResource IconExitMask}" Width="17" Height="17" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Messages (saved / failed / progress). -->
            <TextBlock x:Name="StatusText" Visibility="Collapsed" Foreground="#C8C8C8" FontSize="12" Margin="10,0,10,6"
                       TextWrapping="Wrap" MaxWidth="560" />
        </StackPanel>
    </Border>
</Window>
