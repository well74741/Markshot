<Window x:Class="Markshot.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Markshot.Core"
        Icon="pack://application:,,,/Markshot;component/Assets/markshot.ico"
        Title="Markshot 设置"
        Width="760" Height="560" MinWidth="680" MinHeight="480"
        Background="{DynamicResource T_FF1A1A1A}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">

    <!-- Its own title bar (drawn in the theme's colours, with 帮助): the system one kept its old colour after a theme
         switch until the window was activated again. Resizing, snapping and the system menu stay the system's. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource T_FFB8B8B8}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource T_14FFFFFF}" />
                                <Setter Property="Foreground" Value="{DynamicResource T_FFF0F0F0}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource T_22FFFFFF}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1707A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Left navigation item -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource T_FFB8B8B8}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,8">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Height="14" CornerRadius="1.5" HorizontalAlignment="Left"
                                        Margin="-8,0,0,0" Background="{StaticResource Accent}" Visibility="Hidden" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource T_14FFFFFF}" />
                                <Setter Property="Foreground" Value="{DynamicResource T_FFF0F0F0}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource T_22FFFFFF}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource T_FFFFFFFF}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource T_FFF5F5F5}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource T_FF222222}" />
            <Setter Property="BorderBrush" Value="{DynamicResource T_1FFFFFFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,11,16,13" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource T_FFE6E6E6}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource T_FFA8A8A8}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource T_FF7E7E7E}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="HotkeyField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="点击后直接按下组合键；Backspace 清除，Esc 还原" />
        </Style>

        <Style x:Key="KeyField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
            <Setter Property="Width" Value="40" />
            <Setter Property="MaxLength" Value="1" />
            <Setter Property="CharacterCasing" Value="Upper" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="PasswordField" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource T_2EFFFFFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{DynamicResource T_FFFFFFFF}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every check box of the settings: a small pill switch (the 原位翻译 one's look, sized for 12 px rows). -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="28" Height="16" CornerRadius="8" Background="{DynamicResource T_FF4A4A4A}"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="10" Height="10" Fill="#F2F2F2"
                                         HorizontalAlignment="Left" Margin="3,0" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill switch -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource T_FF4A4A4A}"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#F2F2F2"
                                         HorizontalAlignment="Left" Margin="3,0" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource T_FFE0E0E0}" TextElement.FontSize="12.5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource T_FFC8C8C8}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource T_FF2C2C2C}" BorderBrush="{DynamicResource T_26FFFFFF}" BorderThickness="1"
                                CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="11.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource T_FFFFFFFF}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <!-- Title bar: the navigation's colour on the left, the page's on the right, as the window below. -->
    <Grid x:Name="TitleBar" Height="36">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource T_FF151515}" />
        <Border Grid.Column="1" Background="{DynamicResource T_FF1A1A1A}" />
        <StackPanel x:Name="TitleText" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" Width="16" Height="16"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Markshot 设置" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource T_FFB8B8B8}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="HelpButton" Style="{StaticResource CaptionButton}" FontFamily="Microsoft YaHei UI" FontSize="14" FontWeight="SemiBold"
                    Content="?" ToolTip="帮助：功能介绍与使用方法" Click="Help_Click" />
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="最小化" Click="Minimize_Click" />
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="最大化" Click="Maximize_Click" />
            <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" ToolTip="关闭" Click="TitleClose_Click" />
        </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Background="{DynamicResource T_FF1A1A1A}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource T_FF151515}" BorderBrush="{DynamicResource T_14FFFFFF}" BorderThickness="0,0,1,0">
            <Grid>
            <StackPanel Margin="12,4,12,12">
                <TextBlock Text="Markshot" Foreground="{DynamicResource T_FFF5F5F5}" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,2" />
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource T_FF6E6E6E}" FontSize="11" VerticalAlignment="Center"
                               Background="Transparent" Cursor="Help" MouseEnter="VersionText_MouseEnter" MouseLeave="VersionText_MouseLeave" />
                    <Button x:Name="CheckUpdateButton" Style="{StaticResource ToolButton}" Padding="4,0" Margin="4,0,0,0"
                            Foreground="{DynamicResource T_FF8A8A8A}" ToolTip="检查更新"
                            Click="CheckUpdate_Click" VerticalAlignment="Center">
                        <Border Style="{StaticResource IconRefreshMask}" Width="12" Height="12" Margin="0,2" />
                    </Button>
                </StackPanel>
                <!-- Own line so it is never cut off by the narrow column. -->
                <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" MinWidth="0" Height="24"
                        Padding="10,0" FontSize="11.5" Margin="8,6,0,0" Visibility="Collapsed" HorizontalAlignment="Left"
                        Click="Update_Click" />
                <Border Height="18" />
                <RadioButton x:Name="NavStyle" Style="{StaticResource NavItem}" GroupName="Nav" Tag="Style"
                             Content="样式" IsChecked="True" Checked="Nav_Checked" />
                <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavItem}" GroupName="Nav" Tag="Hotkeys"
                             Content="快捷键" Checked="Nav_Checked" />
                <RadioButton x:Name="NavTranslate" Style="{StaticResource NavItem}" GroupName="Nav" Tag="Translate"
                             Content="翻译" Checked="Nav_Checked" />
                <RadioButton x:Name="NavToolbar" Style="{StaticResource NavItem}" GroupName="Nav" Tag="Toolbar"
                             Content="批注栏" Checked="Nav_Checked" />
                <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="Nav" Tag="General"
                             Content="保存与识别" Checked="Nav_Checked" />
            </StackPanel>

            <!-- Coffee drawer: drag the bar up to pull the QR code out; click it to put it away. -->
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,6">
                <!-- A coffee cup above the bar; hovering the bar turns it into the hint text. -->
                <Grid Margin="0,0,0,-8" Background="Transparent" Cursor="SizeNS"
                      MouseEnter="DrawerHandle_MouseEnter" MouseLeave="DrawerHandle_MouseLeave"
                      MouseLeftButtonDown="DrawerHandle_MouseLeftButtonDown" MouseMove="DrawerHandle_MouseMove"
                      MouseLeftButtonUp="DrawerHandle_MouseLeftButtonUp">
                    <Border x:Name="DrawerCoffee" Style="{StaticResource IconCoffeeMask}" Width="24" Height="24"
                            Background="{DynamicResource T_FF8A8A8A}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock x:Name="DrawerHint" Text="往上拉，请杯咖~" Foreground="{DynamicResource T_FF8A8A8A}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                </Grid>
                <!-- The bar rides on top: pulling it up reveals the QR code underneath. -->
                <Border x:Name="DrawerHandle" Height="22" Background="Transparent" Cursor="SizeNS"
                        ToolTip="往上拉，请杯咖~"
                        MouseEnter="DrawerHandle_MouseEnter" MouseLeave="DrawerHandle_MouseLeave"
                        MouseLeftButtonDown="DrawerHandle_MouseLeftButtonDown" MouseMove="DrawerHandle_MouseMove"
                        MouseLeftButtonUp="DrawerHandle_MouseLeftButtonUp">
                    <Border x:Name="DrawerBar" Width="46" Height="4" CornerRadius="2" Background="{DynamicResource T_4DFFFFFF}"
                            VerticalAlignment="Center" />
                </Border>
                <Border x:Name="DrawerPanel" Height="0" ClipToBounds="True">
                    <!-- Hovered, the code turns over (horizontally) to the WeChat one and back on leaving. -->
                    <Border x:Name="DrawerQrHost" Background="Transparent" Width="136" Height="136" VerticalAlignment="Top" Margin="0,0,0,8"
                            MouseEnter="DrawerQr_MouseEnter" MouseLeave="DrawerQr_MouseLeave">
                        <Image x:Name="DrawerQr" Source="pack://application:,,,/Markshot;component/Assets/donate_qr.png"
                               RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <ScaleTransform x:Name="DrawerQrScale" />
                            </Image.RenderTransform>
                        </Image>
                    </Border>
                </Border>
            </StackPanel>
            </Grid>
        </Border>

        <!-- Pages -->
        <Grid Grid.Column="1" Grid.Row="0">

            <!-- ===== Hotkeys ===== -->
            <ScrollViewer x:Name="PageHotkeys" VerticalScrollBarVisibility="Auto" Padding="24,18,20,6"
                          Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="快捷键" Style="{StaticResource PageTitle}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="全局快捷键" Style="{StaticResource CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="截图" Style="{StaticResource RowLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="CaptureHotkeyBox" Style="{StaticResource HotkeyField}"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="贴剪贴板" Style="{StaticResource RowLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="4" x:Name="PinHotkeyBox" Style="{StaticResource HotkeyField}"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="鼠标穿透" Style="{StaticResource RowLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="MouseThroughHotkeyBox" Style="{StaticResource HotkeyField}"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="恢复贴图" Style="{StaticResource RowLabel}"
                                           ToolTip="重新打开最近关闭的贴图" />
                                <TextBox Grid.Row="2" Grid.Column="4" x:Name="RestorePinHotkeyBox" Style="{StaticResource HotkeyField}"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="录屏" Style="{StaticResource RowLabel}"
                                           ToolTip="打开录屏；录屏打开时按一下开始，录制中再按一下停止" />
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="RecordHotkeyBox" Style="{StaticResource HotkeyField}"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown" />
                                <TextBlock Grid.Row="4" Grid.Column="3" Text="关闭所有贴图" Style="{StaticResource RowLabel}"
                                           ToolTip="一次关闭所有贴图（也在贴图右键菜单里）" />
                                <TextBox Grid.Row="4" Grid.Column="4" x:Name="CloseAllPinsHotkeyBox" Style="{StaticResource HotkeyField}"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown" />
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="点框后按组合键或鼠标中键 / 侧键；Backspace 清除，Esc 还原。" />
                            <CheckBox x:Name="HotkeysDisabledCheck" Margin="0,10,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="禁用所有快捷键（全屏游戏防误触）" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Win + 鼠标键" Style="{StaticResource CardTitle}" />
                            <CheckBox x:Name="WinMouseCheck" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="Win + 鼠标直接划区域" />
                            <StackPanel x:Name="WinMouseRows" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="每个键可选：识别文字 / 贴图 / 复制。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="截图中" Style="{StaticResource CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="显示鼠标" Style="{StaticResource RowLabel}"
                                           ToolTip="截图里显示 / 隐藏鼠标指针（会记住）" />
                                <TextBox Grid.Column="1" x:Name="CaptureCursorKeyBox" Style="{StaticResource HotkeyField}"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" PreviewKeyDown="CaptureKeyBox_PreviewKeyDown" PreviewKeyUp="CaptureKeyBox_PreviewKeyUp" />
                                <TextBlock Grid.Column="3" Text="辅助线" Style="{StaticResource RowLabel}"
                                           ToolTip="以鼠标为中心显示贯通屏幕的十字线，再按一次关闭" />
                                <TextBox Grid.Column="4" x:Name="CrosshairKeyBox" Style="{StaticResource HotkeyField}"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" PreviewKeyDown="CaptureKeyBox_PreviewKeyDown" PreviewKeyUp="CaptureKeyBox_PreviewKeyUp" />
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="仅截图中有效；可用组合键或单个 Alt / Ctrl / Shift。" />
                            <CheckBox x:Name="EscExitsCheck" Margin="0,10,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="Esc / 右键一次直接退出截图（关闭则逐步退出）" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="批注工具（单个字母；Tab 切换样式）" Style="{StaticResource CardTitle}" />
                            <UniformGrid Columns="7">
                                <StackPanel>
                                    <TextBlock Text="图形" Style="{StaticResource RowLabel}" Margin="0,0,0,5" />
                                    <TextBox x:Name="ShapeKeyBox" Style="{StaticResource KeyField}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="画笔" Style="{StaticResource RowLabel}" Margin="0,0,0,5" />
                                    <TextBox x:Name="PenKeyBox" Style="{StaticResource KeyField}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="直线/箭头" Style="{StaticResource RowLabel}" Margin="0,0,0,5" />
                                    <TextBox x:Name="LineKeyBox" Style="{StaticResource KeyField}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="文字" Style="{StaticResource RowLabel}" Margin="0,0,0,5" />
                                    <TextBox x:Name="TextKeyBox" Style="{StaticResource KeyField}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="序号" Style="{StaticResource RowLabel}" Margin="0,0,0,5" />
                                    <TextBox x:Name="NumberKeyBox" Style="{StaticResource KeyField}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="橡皮擦" Style="{StaticResource RowLabel}" Margin="0,0,0,5" />
                                    <TextBox x:Name="EraserKeyBox" Style="{StaticResource KeyField}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="选择" Style="{StaticResource RowLabel}" Margin="0,0,0,5" />
                                    <TextBox x:Name="SelectKeyBox" Style="{StaticResource KeyField}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="贴图窗口" Style="{StaticResource CardTitle}" />
                            <!-- Same 6-column grid as the tool keys above so the cells line up. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="左右翻转" Style="{StaticResource RowLabel}" Margin="0,0,0,5" />
                                    <TextBox x:Name="PinFlipHBox" Style="{StaticResource KeyField}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="上下翻转" Style="{StaticResource RowLabel}" Margin="0,0,0,5" />
                                    <TextBox x:Name="PinFlipVBox" Style="{StaticResource KeyField}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="逆时针 90°" Style="{StaticResource RowLabel}" Margin="0,0,0,5" />
                                    <TextBox x:Name="PinRotateBox" Style="{StaticResource KeyField}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="还原" Style="{StaticResource RowLabel}" Margin="0,0,0,5" />
                                    <TextBox x:Name="PinResetBox" Style="{StaticResource KeyField}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Grid.ColumnSpan="2">
                                    <TextBlock Text="按住拖动贴图" Style="{StaticResource RowLabel}" Margin="0,0,0,5"
                                               ToolTip="按住这个键拖动文字上的地方，移动贴图而不是选中文字（点输入框后按下想用的键）" />
                                    <TextBox x:Name="TextBypassBox" Style="{StaticResource HotkeyField}" HorizontalAlignment="Stretch"
                                             GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                             PreviewKeyDown="CaptureKeyBox_PreviewKeyDown" PreviewKeyUp="CaptureKeyBox_PreviewKeyUp" />
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="PinTextSelectCheck" Margin="0,12,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="贴图上的文字可直接拖选复制（关闭后拖动文字处也是移动贴图）" />
                            <CheckBox x:Name="QuickDoubleClickCheck" Margin="0,8,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="双击截图 / 贴图：复制并关闭" />

                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Translation ===== -->
            <ScrollViewer x:Name="PageTranslate" VerticalScrollBarVisibility="Auto" Padding="24,18,20,6"
                          Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="翻译" Style="{StaticResource PageTitle}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="原位翻译" Style="{StaticResource CardTitle}" />
                            <ToggleButton x:Name="ImmersiveSwitch" Style="{StaticResource Switch}"
                                          Content="截图时把选区文字替换成译文" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="目标语言" Style="{StaticResource RowLabel}" />
                                <DockPanel Grid.Column="1">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource Chip}" Content="简体中文" Click="Language_Click" />
                                        <Button Style="{StaticResource Chip}" Content="English" Click="Language_Click" />
                                        <Button Style="{StaticResource Chip}" Content="日本語" Click="Language_Click" />
                                        <Button Style="{StaticResource Chip}" Content="繁體中文" Click="Language_Click" Margin="0" />
                                    </StackPanel>
                                    <TextBox x:Name="TargetBox" Style="{StaticResource Field}" />
                                </DockPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="翻译服务（OpenAI 兼容接口）" Style="{StaticResource CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Base URL" Style="{StaticResource RowLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="BaseUrlBox" Style="{StaticResource Field}" />

                                <TextBlock Grid.Row="2" Text="API Key" Style="{StaticResource RowLabel}" />
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="ApiKeyPassword" Style="{StaticResource PasswordField}"
                                                 PasswordChanged="ApiKeyPassword_PasswordChanged" />
                                    <TextBox x:Name="ApiKeyBox" Style="{StaticResource Field}" Visibility="Collapsed"
                                             TextChanged="ApiKeyBox_TextChanged" />
                                    <Button Grid.Column="1" x:Name="ApiKeyReveal" Style="{StaticResource ToolButton}"
                                            Content="显示" Margin="6,0,0,0" Click="ApiKeyReveal_Click" />
                                </Grid>

                                <TextBlock Grid.Row="4" Text="模型" Style="{StaticResource RowLabel}" />
                                <Grid Grid.Row="4" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ModelBox" Style="{StaticResource Field}" />
                                    <TextBlock Grid.Column="2" Text="超时（秒）" Style="{StaticResource RowLabel}" Margin="0,0,10,0" />
                                    <TextBox Grid.Column="3" x:Name="TimeoutBox" Style="{StaticResource Field}"
                                             HorizontalContentAlignment="Center" />
                                </Grid>
                            </Grid>

                            <DockPanel Margin="84,12,0,0">
                                <Button DockPanel.Dock="Left" x:Name="TestButton" Style="{StaticResource FooterButton}"
                                        Content="测试连接" Click="Test_Click" />
                                <TextBlock x:Name="TestStatusText" Style="{StaticResource Hint}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" core:Marquee.Enabled="True" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="84,10,0,0"
                                       Text="OpenAI 兼容接口（DeepSeek、Ollama…）；本机地址可不填 Key。" />
                        </StackPanel>
                    </Border>

                    <!-- 离线翻译包: a backup without any API; downloaded by hand, never part of the installer. -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="离线翻译包（备用）" Style="{StaticResource CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="翻译方式" Style="{StaticResource RowLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton x:Name="EngineAuto" Style="{StaticResource SegmentRadio}" GroupName="Engine" Tag="Auto" Content="自动"
                                                 ToolTip="有 API Key 用大模型，否则用离线包" />
                                    <RadioButton x:Name="EngineApi" Style="{StaticResource SegmentRadio}" GroupName="Engine" Tag="Api" Content="大模型 API" />
                                    <RadioButton x:Name="EngineOffline" Style="{StaticResource SegmentRadio}" GroupName="Engine" Tag="Offline" Content="离线翻译包" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="下载源" Style="{StaticResource RowLabel}" />
                                <StackPanel Grid.Row="2" Grid.Column="1" x:Name="MirrorRow" Orientation="Horizontal" />
                                <TextBlock Grid.Row="4" Text="翻译包" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                <StackPanel Grid.Row="4" Grid.Column="1" x:Name="OfflinePackRows" />
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="84,10,0,0" TextWrapping="Wrap"
                                       Text="本机运行，无需网络；中 ↔ 英，每个约 120 MB，按需下载。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Annotation bar ===== -->
            <ScrollViewer x:Name="PageToolbar" VerticalScrollBarVisibility="Auto" Padding="24,18,20,6"
                          Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="批注栏" Style="{StaticResource PageTitle}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="按钮显示与顺序" Style="{StaticResource CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="截图模式" Style="{StaticResource RowLabel}" />
                                <Border Grid.Column="1" Background="{DynamicResource T_FF1B1B1B}" CornerRadius="7" Padding="5,3" HorizontalAlignment="Left">
                                    <WrapPanel>
                                        <StackPanel x:Name="CaptureToolsRow" Orientation="Horizontal" />
                                        <Border Width="1" Height="18" Background="{DynamicResource T_33FFFFFF}" Margin="6,0" />
                                        <StackPanel x:Name="CaptureActionsRow" Orientation="Horizontal" />
                                    </WrapPanel>
                                </Border>
                                <TextBlock Grid.Row="2" Text="贴图模式" Style="{StaticResource RowLabel}" />
                                <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource T_FF1B1B1B}" CornerRadius="7" Padding="5,3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel x:Name="PinToolsRow" Orientation="Horizontal" />
                                        <Border Width="1" Height="18" Background="{DynamicResource T_33FFFFFF}" Margin="6,0" />
                                        <StackPanel x:Name="PinActionsRow" Orientation="Horizontal" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Row="4" Text="图片编辑器" Style="{StaticResource RowLabel}" />
                                <Border Grid.Row="4" Grid.Column="1" Background="{DynamicResource T_FF1B1B1B}" CornerRadius="7" Padding="5,3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel x:Name="EditorToolsRow" Orientation="Horizontal" />
                                        <Border Width="1" Height="18" Background="{DynamicResource T_33FFFFFF}" Margin="6,0" />
                                        <StackPanel x:Name="EditorActionsRow" Orientation="Horizontal" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="84,8,0,0"
                                       Text="单击显示 / 隐藏，长按拖动排序。" />
                            <CheckBox x:Name="HideChevronsCheck" Margin="84,10,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="隐藏批注工具旁的收纳按钮 ▾" />
                            <TextBlock Style="{StaticResource Hint}" Margin="124,4,0,0" TextWrapping="Wrap"
                                       Text="隐藏后悬停工具按钮展开样式列表。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Style ===== -->
            <ScrollViewer x:Name="PageStyle" VerticalScrollBarVisibility="Auto" Padding="24,18,20,6">
                <StackPanel>
                    <TextBlock Text="样式" Style="{StaticResource PageTitle}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="外观" Style="{StaticResource CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="主题" Style="{StaticResource RowLabel}" />
                                <Border Grid.Column="1" Background="{DynamicResource T_FF2A2A2A}" CornerRadius="5" Padding="2" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeDark" Style="{StaticResource SegmentRadio}" GroupName="Theme" Tag="Dark"
                                                     Content="暗色" Checked="Theme_Checked" />
                                        <RadioButton x:Name="ThemeLight" Style="{StaticResource SegmentRadio}" GroupName="Theme" Tag="Light"
                                                     Content="浅色" Checked="Theme_Checked" />
                                        <RadioButton x:Name="ThemeSystem" Style="{StaticResource SegmentRadio}" GroupName="Theme" Tag="System"
                                                     Content="跟随系统" Checked="Theme_Checked" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Row="2" Text="工具栏大小" Style="{StaticResource RowLabel}" />
                                <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource T_FF2A2A2A}" CornerRadius="5" Padding="2" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SizeSmall" Style="{StaticResource SegmentRadio}" GroupName="UiSize" Tag="Small"
                                                     Content="小" Checked="UiSize_Checked" />
                                        <RadioButton x:Name="SizeMedium" Style="{StaticResource SegmentRadio}" GroupName="UiSize" Tag="Medium"
                                                     Content="中" Checked="UiSize_Checked" />
                                        <RadioButton x:Name="SizeLarge" Style="{StaticResource SegmentRadio}" GroupName="UiSize" Tag="Large"
                                                     Content="大" Checked="UiSize_Checked" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="84,8,0,0" TextWrapping="Wrap"
                                       Text="选择后即时预览，点“保存”生效。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="贴图阴影" Style="{StaticResource CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="阴影大小" Style="{StaticResource RowLabel}" Margin="0,0,10,0" />
                                <DockPanel Grid.Column="1">
                                    <TextBlock x:Name="ShadowSizeValue" DockPanel.Dock="Right" Width="34" TextAlignment="Right"
                                               Foreground="{DynamicResource T_FFC8C8C8}" FontSize="12" VerticalAlignment="Center" />
                                    <Slider x:Name="ShadowSizeSlider" Minimum="0" Maximum="40" IsMoveToPointEnabled="True"
                                            VerticalAlignment="Center" ValueChanged="Shadow_Changed" />
                                </DockPanel>
                                <TextBlock Grid.Column="2" Text="颜色" Style="{StaticResource RowLabel}" Margin="18,0,8,0" />
                                <Button Grid.Column="3" x:Name="ShadowColorButton" Style="{StaticResource FooterButton}" MinWidth="0"
                                        Width="44" Height="26" Padding="0" Click="ShadowColor_Click" ToolTip="阴影颜色">
                                    <Border x:Name="ShadowColorSwatch" Width="22" Height="14" CornerRadius="3"
                                            BorderBrush="{DynamicResource T_55FFFFFF}" BorderThickness="1" />
                                </Button>
                                <DockPanel Grid.Column="4" Margin="18,0,0,0">
                                    <TextBlock Text="透明度" DockPanel.Dock="Left" Style="{StaticResource RowLabel}" Margin="0,0,10,0" />
                                    <TextBlock x:Name="ShadowOpacityValue" DockPanel.Dock="Right" Width="38" TextAlignment="Right"
                                               Foreground="{DynamicResource T_FFC8C8C8}" FontSize="12" VerticalAlignment="Center" />
                                    <Slider x:Name="ShadowOpacitySlider" Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                                            VerticalAlignment="Center" ValueChanged="Shadow_Changed" />
                                </DockPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="FloatCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="悬浮按钮" Style="{StaticResource CardTitle}" />
                            <CheckBox x:Name="FloatEnabledCheck" Margin="84,0,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="显示悬浮按钮（点击行为可自定义，悬停展开更多）" Click="FloatEnabled_Click" />
                            <CheckBox x:Name="FloatFullscreenCheck" Margin="84,8,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="全屏程序（视频、游戏等）在前面时自动隐藏" Click="FloatFullscreen_Click" />
                            <CheckBox x:Name="FloatCaptureHideCheck" Margin="84,8,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="截图时隐藏" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="浮窗按钮" Style="{StaticResource RowLabel}" />
                                <Border Grid.Column="1" Background="{DynamicResource T_FF1B1B1B}" CornerRadius="7" Padding="5,3" HorizontalAlignment="Left">
                                    <Grid>
                                        <!-- 点击行为: the coloured plate under the chosen button; slides with the knob below. -->
                                        <Canvas IsHitTestVisible="False" ClipToBounds="False">
                                            <Border x:Name="FloatClickPlate" Width="28" Height="28" CornerRadius="5" />
                                        </Canvas>
                                        <StackPanel x:Name="FloatActionsRow" Orientation="Horizontal" />
                                    </Grid>
                                </Border>
                                <!-- 点击行为: a slider under the row; its knob snaps under a button, that button is what a click does. -->
                                <TextBlock Grid.Row="2" Text="点击行为" Style="{StaticResource RowLabel}" />
                                <Canvas Grid.Row="2" Grid.Column="1" x:Name="FloatClickTrack" Height="18" HorizontalAlignment="Left" Margin="5,0,0,0"
                                        Background="Transparent" Cursor="Hand" ToolTip="左右拖动，对准哪个按钮，单击悬浮按钮就执行哪个功能"
                                        MouseLeftButtonDown="FloatClick_MouseDown" MouseMove="FloatClick_MouseMove" MouseLeftButtonUp="FloatClick_MouseUp" />
                                <TextBlock Grid.Row="4" Text="图标" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                    <!-- Preview: drop a picture here, or Ctrl+V a copied one. -->
                                    <Border x:Name="FloatIconPreview" Width="76" Height="76" CornerRadius="8" AllowDrop="True" Focusable="True"
                                            Background="{DynamicResource T_FF1B1B1B}" BorderBrush="{DynamicResource T_33FFFFFF}" BorderThickness="1"
                                            ToolTip="拖入图片或按 Ctrl+V 粘贴来替换" Cursor="Hand"
                                            DragEnter="FloatIcon_DragOver" DragOver="FloatIcon_DragOver" Drop="FloatIcon_Drop"
                                            MouseLeftButtonUp="FloatIconPreview_Click">
                                        <Image x:Name="FloatIconImage" Width="62" Height="62" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="FloatIconPick" Style="{StaticResource FooterButton}" Content="选择图片…" Click="FloatIconPick_Click" />
                                            <Button x:Name="FloatIconReset" Style="{StaticResource FooterButton}" Content="重置" Margin="8,0,0,0" Click="FloatIconReset_Click" />
                                        </StackPanel>
                                        <DockPanel Margin="0,10,0,0" Width="230" HorizontalAlignment="Left">
                                            <TextBlock Text="尺寸" DockPanel.Dock="Left" Style="{StaticResource RowLabel}" Margin="0,0,10,0" Width="40" />
                                            <TextBlock x:Name="FloatSizeValue" DockPanel.Dock="Right" Width="38" TextAlignment="Right"
                                                       Foreground="{DynamicResource T_FFC8C8C8}" FontSize="12" VerticalAlignment="Center" />
                                            <Slider x:Name="FloatSizeSlider" Minimum="100" Maximum="200" IsMoveToPointEnabled="True"
                                                    VerticalAlignment="Center" ValueChanged="FloatSize_Changed" />
                                        </DockPanel>
                                        <DockPanel Margin="0,8,0,0" Width="230" HorizontalAlignment="Left">
                                            <TextBlock Text="透明度" DockPanel.Dock="Left" Style="{StaticResource RowLabel}" Margin="0,0,10,0" Width="40" />
                                            <TextBlock x:Name="FloatOpacityValue" DockPanel.Dock="Right" Width="38" TextAlignment="Right"
                                                       Foreground="{DynamicResource T_FFC8C8C8}" FontSize="12" VerticalAlignment="Center" />
                                            <Slider x:Name="FloatOpacitySlider" Minimum="20" Maximum="100" IsMoveToPointEnabled="True"
                                                    VerticalAlignment="Center" ValueChanged="FloatOpacity_Changed" />
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="84,8,0,0" TextWrapping="Wrap"
                                       Text="按钮单击显示 / 隐藏，长按排序；图标支持图片和动图，可拖入或 Ctrl+V。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== General ===== -->
            <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto" Padding="24,18,20,6"
                          Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="保存与识别" Style="{StaticResource PageTitle}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="截图识别" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="84,0,0,6" TextWrapping="Wrap"
                                       Text="优先读取系统界面元素，读不到时按画面识别。" />
                            <CheckBox x:Name="DetectAutoCheck" Margin="84,2,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="自动识别截图区域（鼠标经过时自动框住）" Click="DetectAuto_Click" />
                            <CheckBox x:Name="DetectElementsCheck" Margin="104,8,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="识别 UI 元素：文字、图片、表格、按钮等" />
                            <CheckBox x:Name="DetectWindowsCheck" Margin="104,8,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="识别窗口" />
                            <DockPanel x:Name="DetectSensitivityRow" Margin="104,10,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="识别范围" DockPanel.Dock="Left" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock x:Name="DetectSensitivityValue" DockPanel.Dock="Right" Width="96" TextAlignment="Right"
                                           Foreground="{DynamicResource T_FFC8C8C8}" FontSize="12" VerticalAlignment="Center" />
                                <Slider x:Name="DetectSensitivitySlider" Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True" Width="150" VerticalAlignment="Center" ValueChanged="DetectSensitivity_Changed"
                                        ToolTip="悬停时先框住的大小；滚轮放大 / 缩小范围" />
                            </DockPanel>
                            <CheckBox x:Name="CaptureCursorCheck" Margin="84,8,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="截图包含鼠标指针（截图中也可用快捷键切换）" />
                            <TextBlock Style="{StaticResource Hint}" Margin="84,8,0,0" TextWrapping="Wrap"
                                       Text="悬停自动框选，单击截取；滚轮切换范围。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="打开方式" Style="{StaticResource CardTitle}" />
                            <CheckBox x:Name="OpenWithCheck" Margin="84,2,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="加入图片的「打开方式」" />
                            <StackPanel Orientation="Horizontal" Margin="84,10,0,0">
                                <Button Content="设为图片默认打开方式…" Style="{StaticResource FooterButton}" Click="DefaultOpen_Click" />
                                <Button Content="Windows 默认应用设置" Style="{StaticResource FooterButton}" Margin="8,0,0,0" Click="DefaultApps_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="84,8,0,0" TextWrapping="Wrap"
                                       Text="在弹出的窗口里选 Markshot 并勾选「始终使用此应用」。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="保存" Style="{StaticResource CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="保存目录" Style="{StaticResource RowLabel}" />
                                <TextBox Grid.Column="1" x:Name="SaveDirBox" Style="{StaticResource Field}" />
                                <Button Grid.Column="2" Content="浏览…" Style="{StaticResource FooterButton}"
                                        Click="Browse_Click" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="84,8,0,0"
                                       Text="留空为 图片\Markshot；Ctrl+Shift+S 直接保存到这里。" />
                            <CheckBox x:Name="CopyFileCheck" Margin="84,10,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="复制时附带 PNG 文件（可粘贴到文件夹）" />
                            <CheckBox x:Name="AskOpenFolderCheck" Margin="84,8,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="保存图片后询问是否打开所在文件夹" />
                            <CheckBox x:Name="AutoStartCheck" Margin="84,8,0,0" Foreground="{DynamicResource T_FFD8D8D8}" FontSize="12"
                                      Content="开机自动启动 Markshot" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="文字识别（本地 PP-OCRv5）" Style="{StaticResource CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="识别模型" Style="{StaticResource RowLabel}" />
                                <TextBox Grid.Column="1" x:Name="OcrLanguageBox" Style="{StaticResource Field}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="留空 = 中英日混排模型；填 en = 英文/拉丁专用模型" />
                            </Grid>
                            <!-- Larger models for special pictures, downloaded by hand (as the offline translation packs). -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="扩展模型" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                <StackPanel Grid.Column="1" x:Name="OcrPackRows" />
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="84,6,0,0" TextWrapping="Wrap"
                                       Text="日常文字识别已内置；公式识别按需下载，装好后文字识别窗口出现「公式」按钮。下载源同翻译页。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="配置文件" Style="{StaticResource CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ConfigPathText" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" core:Marquee.Enabled="True" />
                                <Button Grid.Column="1" Content="打开所在文件夹" Style="{StaticResource FooterButton}"
                                        Click="OpenConfigFolder_Click" Margin="12,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Column="1" Grid.Row="1" BorderBrush="{DynamicResource T_14FFFFFF}" BorderThickness="0,1,0,0" Padding="24,12,20,14">
            <DockPanel>
                <Button x:Name="ResetDefaultsButton" DockPanel.Dock="Left" Content="恢复默认设置" ToolTip="所有设置恢复为默认值（翻译 API Key 保留）"
                        Style="{StaticResource FooterButton}" Click="ResetDefaults_Click" Margin="0,0,14,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="关闭" ToolTip="关闭设置（没保存的修改会询问）" Style="{StaticResource FooterButton}" Click="Cancel_Click" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="8,0,0,0"
                            IsDefault="True" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" core:Marquee.Enabled="True" />
            </DockPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
