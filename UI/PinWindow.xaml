<Window x:Class="Markshot.UI.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:annotations="clr-namespace:Markshot.Annotations"
        xmlns:ui="clr-namespace:Markshot.UI"
        Title="Markshot Pin"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="False"
        SnapsToDevicePixels="True"
        Focusable="True"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp">

    <!-- The annotation toolbar lives in its own window (ToolbarHostWindow) so it can be dragged alone. -->
    <Grid x:Name="RootGrid" Margin="16">
        <Grid x:Name="ImageHost" HorizontalAlignment="Left" VerticalAlignment="Top"
              ClipToBounds="False">
            <Border x:Name="ImageShadowLayer" Background="#48000000" IsHitTestVisible="False">
                <Border.Effect>
                    <BlurEffect x:Name="ShadowBlur" Radius="12" KernelType="Gaussian" />
                </Border.Effect>
            </Border>
            <Image x:Name="Img" Stretch="Fill" SnapsToDevicePixels="True" />
            <ui:PinTextLayer x:Name="TextLayer" />
            <annotations:AnnotationEditor x:Name="Editor" Visibility="Collapsed" IsHitTestVisible="False" />
            <Rectangle x:Name="InputLayer" Fill="Transparent" Visibility="Collapsed"
                       MouseLeftButtonDown="Input_MouseLeftButtonDown"
                       MouseMove="Input_MouseMove"
                       MouseLeftButtonUp="Input_MouseLeftButtonUp"
                       MouseRightButtonDown="Input_MouseRightButtonDown" />
            <Canvas x:Name="UiLayer">
                <TextBox x:Name="TextEditor" Style="{StaticResource InlineTextBox}" Visibility="Collapsed" />
                <TextBox x:Name="WatermarkEditor" Style="{StaticResource InputBox}"
                         Width="240" MinHeight="34" FontSize="14" Visibility="Collapsed"
                         Background="{DynamicResource T_E6101010}" BorderBrush="#4C8DFF"
                         ToolTip="水印文字：Enter 确定，Esc 取消"
                         PreviewKeyDown="WatermarkEditor_PreviewKeyDown" />
            </Canvas>
            <Border x:Name="FrameBorder" BorderThickness="0" BorderBrush="Transparent" IsHitTestVisible="False" />
            <!-- Picked together with other pins (Shift+click). -->
            <Rectangle x:Name="GroupMark" Stroke="#4C8DFF" StrokeThickness="2" StrokeDashArray="3 2"
                       Visibility="Collapsed" IsHitTestVisible="False" />
            <Border x:Name="PinStatus" Visibility="Collapsed" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                    Background="{DynamicResource T_E61C1C1C}" BorderBrush="{DynamicResource T_33FFFFFF}" BorderThickness="1"
                    CornerRadius="6" Padding="8,3">
                <TextBlock x:Name="PinStatusText" Foreground="{DynamicResource T_FFEDEDED}" FontSize="12" MaxWidth="360"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>

    </Grid>
</Window>
