<Window x:Class="Markshot.UI.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:annotations="clr-namespace:Markshot.Annotations"
        Title="Markshot Pin"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="False"
        SnapsToDevicePixels="True"
        Focusable="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="ImageHost" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top"
              ClipToBounds="True">
            <Image x:Name="Img" Stretch="Fill" SnapsToDevicePixels="True" />
            <annotations:AnnotationEditor x:Name="Editor" Visibility="Collapsed" IsHitTestVisible="False" />
            <Rectangle x:Name="InputLayer" Fill="Transparent" Visibility="Collapsed"
                       MouseLeftButtonDown="Input_MouseLeftButtonDown"
                       MouseMove="Input_MouseMove"
                       MouseLeftButtonUp="Input_MouseLeftButtonUp" />
            <Canvas x:Name="UiLayer">
                <TextBox x:Name="TextEditor" Style="{StaticResource InputBox}"
                         Width="260" MinHeight="34" FontSize="16" Visibility="Collapsed"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Background="#E6101010" BorderBrush="#4C8DFF"
                         PreviewKeyDown="TextEditor_PreviewKeyDown" />
            </Canvas>
            <Border x:Name="FrameBorder" BorderThickness="1" BorderBrush="#FF3B82F6" IsHitTestVisible="False" />
        </Grid>

        <Border x:Name="EditToolbar" Grid.Row="1" Visibility="Collapsed" Background="#F21E1E1E"
                BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="9" Padding="6,4" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <RadioButton x:Name="ToolSelect" Style="{StaticResource IconToolRadio}"
                             Tag="Select" GroupName="Tool" Checked="Tool_Checked" IsChecked="True" ToolTip="选择/移动 (V)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSelect}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}" />
                </RadioButton>
                <RadioButton x:Name="ToolRect" Style="{StaticResource IconToolRadio}" Tag="Rectangle" GroupName="Tool" Checked="Tool_Checked" ToolTip="矩形 (Shift+1)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRect}" />
                </RadioButton>
                <RadioButton x:Name="ToolEllipse" Style="{StaticResource IconToolRadio}" Tag="Ellipse" GroupName="Tool" Checked="Tool_Checked" ToolTip="椭圆">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconEllipse}" />
                </RadioButton>
                <RadioButton x:Name="ToolArrow" Style="{StaticResource IconToolRadio}" Tag="Arrow" GroupName="Tool" Checked="Tool_Checked" ToolTip="箭头 (Shift+3)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconArrow}" />
                </RadioButton>
                <RadioButton x:Name="ToolLine" Style="{StaticResource IconToolRadio}" Tag="Line" GroupName="Tool" Checked="Tool_Checked" ToolTip="直线 (Shift+2)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconLine}" />
                </RadioButton>
                <RadioButton x:Name="ToolPen" Style="{StaticResource IconToolRadio}" Tag="Pen" GroupName="Tool" Checked="Tool_Checked" ToolTip="画笔 (Shift+5)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPen}" />
                </RadioButton>
                <RadioButton x:Name="ToolHighlighter" Style="{StaticResource IconToolRadio}" Tag="Highlighter" GroupName="Tool" Checked="Tool_Checked" ToolTip="荧光笔 (Shift+6)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconHighlight}" />
                </RadioButton>
                <RadioButton x:Name="ToolMosaic" Style="{StaticResource IconToolRadio}" Tag="Mosaic" GroupName="Tool" Checked="Tool_Checked" ToolTip="马赛克 (Shift+7)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconMosaic}" />
                </RadioButton>
                <RadioButton x:Name="ToolText" Style="{StaticResource IconToolRadio}" Tag="Text" GroupName="Tool" Checked="Tool_Checked" ToolTip="文字 (Shift+8)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconText}" />
                </RadioButton>
                <RadioButton x:Name="ToolNumber" Style="{StaticResource IconToolRadio}" Tag="Number" GroupName="Tool" Checked="Tool_Checked" ToolTip="序号 (Shift+4)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconNumber}" />
                </RadioButton>
                <RadioButton x:Name="ToolEraser" Style="{StaticResource IconToolRadio}" Tag="Eraser" GroupName="Tool" Checked="Tool_Checked" ToolTip="橡皮擦 (Shift+9)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconEraser}" />
                </RadioButton>

                <Border Width="1" Height="18" Background="#33FFFFFF" Margin="6,0" />

                <Button x:Name="UndoButton" Style="{StaticResource IconToolButton}" Click="Undo_Click" ToolTip="撤销 (Ctrl+Z)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconUndo}" />
                </Button>
                <Button x:Name="RedoButton" Style="{StaticResource IconToolButton}" Click="Redo_Click" ToolTip="重做 (Ctrl+Y)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRedo}" />
                </Button>

                <Border Width="1" Height="18" Background="#33FFFFFF" Margin="6,0" />

                <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center" />

                <Button x:Name="CustomColorButton" Style="{StaticResource IconToolButton}" Click="CustomColor_Click" ToolTip="自定义颜色"
                        AutomationProperties.Name="自定义颜色">
                    <Grid Width="18" Height="18">
                        <Ellipse x:Name="CustomColorRing" Stroke="#D8D8D8" StrokeThickness="1.5" Fill="Transparent" />
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}" Width="9" Height="9" />
                    </Grid>
                </Button>

                <Border Width="1" Height="18" Background="#33FFFFFF" Margin="6,0" />

                <Slider x:Name="WidthSlider" Width="84" Minimum="1" Maximum="16" Value="3"
                        ValueChanged="Width_Changed" VerticalAlignment="Center" ToolTip="笔触/图形粗细" />
                <TextBlock x:Name="WidthValue" Text="3" Foreground="#C8C8C8" FontSize="11" Width="20"
                           TextAlignment="Center" VerticalAlignment="Center" />

                <Border Width="1" Height="18" Background="#33FFFFFF" Margin="6,0" />

                <Button Style="{StaticResource IconToolButton}" Click="Copy_Click" ToolTip="复制">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCopy}" />
                </Button>
                <Button Style="{StaticResource IconToolButton}" Click="Save_Click" ToolTip="另存为">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSave}" />
                </Button>
                <Button Style="{StaticResource IconToolButton}" Click="Translate_Click" ToolTip="翻译">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconTranslate}" />
                </Button>

                <Border Width="1" Height="18" Background="#33FFFFFF" Margin="6,0" />

                <Button Style="{StaticResource AccentButton}" Width="30" Height="30" Padding="0" Click="ApplyEdit_Click" ToolTip="应用 (Ctrl+S)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCheck}" />
                </Button>
                <Button Style="{StaticResource IconToolButton}" Click="CancelEdit_Click" ToolTip="取消 (Esc)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconClose}" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
