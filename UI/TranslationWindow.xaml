<Window x:Class="Markshot.UI.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Markshot;component/Assets/markshot.ico"
        Title="Markshot 翻译"
        Width="980" Height="600" MinWidth="720" MinHeight="420"
        Background="{DynamicResource T_FF1A1A1A}"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        PreviewKeyDown="OnPreviewKeyDown"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Card holding one text pane: header row (title + actions) and a borderless editor. -->
        <Style x:Key="Pane" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource T_FF222222}" />
            <Setter Property="BorderBrush" Value="{DynamicResource T_1FFFFFFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="PaneTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource T_FFE6E6E6}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PaneMeta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource T_FF8A8A8A}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,1,0,0" />
        </Style>

        <!-- Small text action inside a pane header. -->
        <!-- Actions (导出, 复制): a filled plate. Switches (表格, 公式) below: an outline, filled blue when on. -->
        <Style x:Key="PaneAction" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Foreground" Value="{DynamicResource T_FFE0E0E0}" />
            <Setter Property="Background" Value="{DynamicResource T_22FFFFFF}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="PaneToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource T_FFC8C8C8}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource T_44FFFFFF}" BorderThickness="1" CornerRadius="5" Padding="9,2">
                            <StackPanel Orientation="Horizontal">
                                <!-- a small dot: the switch's state at a glance -->
                                <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{DynamicResource T_66FFFFFF}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource T_14FFFFFF}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Dot" Property="Fill" Value="White" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaneEditor" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource T_FFF0F0F0}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="{DynamicResource T_FFFFFFFF}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="12,10,6,12" />
            <Setter Property="TextBlock.LineHeight" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- TextBox applies Padding inside the content host itself. -->
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark drop-down for the target language. -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource T_FFF0F0F0}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource T_2EFFFFFF}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FF4C8DFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource T_FFF0F0F0}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="32" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{DynamicResource T_FF262626}" BorderBrush="{DynamicResource T_2EFFFFFF}"
                                                BorderThickness="1" CornerRadius="5">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource T_FFB8B8B8}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource T_55FFFFFF}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4C8DFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" VerticalOffset="4">
                                <Border Background="{DynamicResource T_FF1E1E1E}" BorderBrush="{DynamicResource T_33FFFFFF}" BorderThickness="1" CornerRadius="8"
                                        Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title on the left, target language + translate on the right. -->
        <Grid Grid.Row="0" Margin="20,16,20,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitle" Text="截图翻译" FontSize="17" Foreground="{DynamicResource T_FFF5F5F5}" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderSubtitle" Text="本地 OCR + AI 翻译" FontSize="12" Foreground="{DynamicResource T_FF8A8A8A}"
                           VerticalAlignment="Center" Margin="10,2,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="译成" Foreground="{DynamicResource T_FF9A9A9A}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="TargetBox" Style="{StaticResource DarkCombo}" Width="150" VerticalAlignment="Center"
                          ToolTip="自动：识别到中文译成英文，其它语言译成中文" />
                <Button x:Name="TranslateButton" Style="{StaticResource PrimaryButton}" Content="翻译"
                        Click="Translate_Click" Margin="8,0,0,0" ToolTip="翻译左侧原文（Ctrl+Enter）" />
            </StackPanel>
        </Grid>

        <!-- Two panes of equal width. -->
        <Grid Grid.Row="1" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Pane}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,10,8,0" Height="28">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="原文" Style="{StaticResource PaneTitle}" />
                            <TextBlock x:Name="SourceMeta" Text="识别结果，可编辑" Style="{StaticResource PaneMeta}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Shown when tables were found: the text, or the tables as tables. -->
                            <ToggleButton x:Name="TableToggle" Style="{StaticResource PaneToggle}" Content="表格" Visibility="Collapsed"
                                          ToolTip="以表格显示识别出的表格（复制时可直接粘贴到 Excel / Word）" Checked="TableToggle_Changed" Unchecked="TableToggle_Changed" />
                            <ToggleButton x:Name="FormulaButton" Content="公式" Style="{StaticResource PaneToggle}" Click="Formula_Click" Visibility="Collapsed"
                                          ToolTip="识别成 LaTeX 公式（再点一下回到文字）。看起来像公式时才出现" />
                            <Button Content="导出" Style="{StaticResource PaneAction}" Click="Export_Click" ToolTip="把识别结果存成文件：Excel / Markdown / 文本" />
                            <Button Content="复制" Style="{StaticResource PaneAction}" Click="CopySource_Click" ToolTip="复制原文" />
                        </StackPanel>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource T_14FFFFFF}" Margin="14,8,14,0" />
                    <!-- 二维码 / 条形码 found in the picture: links open on a click. -->
                    <StackPanel x:Name="CodePanel" DockPanel.Dock="Top" Margin="14,8,14,0" Visibility="Collapsed" />
                    <Grid>
                        <TextBox x:Name="SourceBox" Style="{StaticResource PaneEditor}" />
                        <ScrollViewer x:Name="TableView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="Collapsed"
                                      Padding="12,10,8,12">
                            <StackPanel x:Name="TablePanel" />
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Pane}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,10,8,0" Height="28">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="译文" Style="{StaticResource PaneTitle}" />
                            <TextBlock x:Name="ResultMeta" Text="" Style="{StaticResource PaneMeta}" />
                        </StackPanel>
                        <Button Content="复制" Style="{StaticResource PaneAction}" HorizontalAlignment="Right"
                                Click="Copy_Click" ToolTip="复制译文" />
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource T_14FFFFFF}" Margin="14,8,14,0" />
                    <Grid>
                        <TextBox x:Name="ResultBox" Style="{StaticResource PaneEditor}" IsReadOnly="True" />
                        <TextBlock x:Name="ResultPlaceholder" Text="点击右上角“翻译”生成译文" Foreground="{DynamicResource T_FF5E5E5E}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer: status on the left, actions on the right. -->
        <!-- Footer in the panes' columns: under 原文 the status and its 贴到屏幕; under 译文 its 贴到屏幕 and 关闭 (both on the right). -->
        <Grid Grid.Row="2" Margin="20,12,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource T_FF5E5E5E}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource T_FF9A9A9A}" FontSize="12" Margin="8,0,0,0"
                           VerticalAlignment="Center" Text="准备就绪" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="PinSourceButton" Content="贴到屏幕" Style="{StaticResource FooterButton}" Click="PinSource_Click"
                    HorizontalAlignment="Right" ToolTip="把原文做成贴图" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PinResultButton" Content="贴到屏幕" Style="{StaticResource FooterButton}" Click="Pin_Click"
                        ToolTip="把译文做成贴图" />
                <Button Content="关闭" Style="{StaticResource FooterButton}" Click="Close_Click" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
