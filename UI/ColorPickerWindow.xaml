<Window x:Class="Markshot.UI.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Markshot.Core"
        Title="选择颜色"
        Width="286" Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <LinearGradientBrush x:Key="HueBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF0000" Offset="0" />
            <GradientStop Color="#FFFF00" Offset="0.17" />
            <GradientStop Color="#00FF00" Offset="0.33" />
            <GradientStop Color="#00FFFF" Offset="0.5" />
            <GradientStop Color="#0000FF" Offset="0.67" />
            <GradientStop Color="#FF00FF" Offset="0.83" />
            <GradientStop Color="#FF0000" Offset="1" />
        </LinearGradientBrush>

        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0 H8 V8 H0 Z" />
                    <GeometryDrawing Brush="#FFBEBEBE">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,4,4" />
                                <RectangleGeometry Rect="4,4,4,4" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="ColorSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="core:SliderDragBehavior.Enabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="10" CornerRadius="5" Background="{TemplateBinding Background}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#FFFFFFFF" Stroke="#FF9A9A9A" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FF1C1C1C" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="220" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <TextBlock Text="选择颜色" Foreground="#FFF0F0F0" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button x:Name="TitleCloseButton" Content="×" Foreground="#FFB8B8B8" Background="Transparent"
                        BorderThickness="0" FontSize="20" Width="28" Height="26" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Cursor="Hand" Click="Cancel_Click" />
            </Grid>

            <Border x:Name="SvHost" Grid.Row="1" CornerRadius="4" ClipToBounds="True"
                    MouseLeftButtonDown="Sv_MouseLeftButtonDown"
                    MouseMove="Sv_MouseMove"
                    MouseLeftButtonUp="Sv_MouseLeftButtonUp">
                <Grid>
                    <Rectangle Fill="#FFFFFFFF" />
                    <Rectangle x:Name="SatLayer" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#FF000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas x:Name="SvCanvas">
                        <Ellipse x:Name="SvCursor" Width="14" Height="14" Stroke="#FFFFFFFF" StrokeThickness="2"
                                 Fill="Transparent" IsHitTestVisible="False" />
                    </Canvas>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="EyedropperButton" Style="{StaticResource IconToolButton}" Width="30" Height="24"
                        ToolTip="吸管：点击后再点屏幕取色" Click="Eyedropper_Click">
                    <Border Style="{StaticResource IconEyedropperMask}" />
                </Button>
                <Slider x:Name="HueSlider" Grid.Column="1" Style="{StaticResource ColorSliderStyle}"
                        IsMoveToPointEnabled="True" Minimum="0" Maximum="360" Value="10"
                        Background="{StaticResource HueBrush}" ValueChanged="Hue_Changed" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Height="14" CornerRadius="7" Background="{StaticResource CheckerBrush}" />
                <Slider x:Name="AlphaSlider" Grid.Column="1" Style="{StaticResource ColorSliderStyle}"
                        IsMoveToPointEnabled="True" Minimum="0" Maximum="1" Value="1"
                        ValueChanged="Alpha_Changed" />
            </Grid>

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="66" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="30" Background="#FF2A2A2A" BorderBrush="#33FFFFFF"
                        BorderThickness="1" CornerRadius="5">
                    <Grid Margin="9,0,7,0">
                        <TextBlock Text="Hex" Foreground="#FFE8E8E8" VerticalAlignment="Center" FontSize="12" />
                        <Path Data="M0 0 L4 4 L8 0" Stroke="#FFB8B8B8" StrokeThickness="1.3"
                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <TextBox x:Name="HexBox" Grid.Column="1" Height="30" Margin="6,0,6,0"
                         Background="#FF2A2A2A" Foreground="#FFF0F0F0" BorderBrush="#33FFFFFF"
                         BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"
                         FontFamily="Consolas" FontSize="13" CaretBrush="#FFF0F0F0"
                         PreviewKeyDown="HexBox_PreviewKeyDown"
                         LostKeyboardFocus="HexBox_LostKeyboardFocus" />
                <TextBox x:Name="AlphaPercentBox" Grid.Column="2" Height="30"
                         Background="#FF2A2A2A" Foreground="#FFF0F0F0" BorderBrush="#33FFFFFF"
                         BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center"
                         FontFamily="Consolas" FontSize="12" TextAlignment="Right" CaretBrush="#FFF0F0F0"
                         PreviewKeyDown="AlphaBox_PreviewKeyDown"
                         LostKeyboardFocus="AlphaBox_LostKeyboardFocus" />
            </Grid>

            <Grid Grid.Row="5" Margin="0,14,0,0">
                <Button Content="确认" Width="84" Height="32" HorizontalAlignment="Right"
                        Background="#FF3B82F6" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="Ok_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="取消" Width="84" Height="32" HorizontalAlignment="Right" Margin="0,0,92,0"
                        Background="#FF2A2A2A" Foreground="#FFF0F0F0" BorderBrush="#33FFFFFF"
                        BorderThickness="1" Cursor="Hand" Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
