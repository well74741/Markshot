<Window x:Class="Markshot.UI.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义颜色"
        Width="340" Height="270"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#FF1C1C1C"
        FontFamily="Microsoft YaHei UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="54" CornerRadius="6" BorderThickness="1" BorderBrush="#33FFFFFF">
            <Border x:Name="Preview" Background="#FF37D6C0" CornerRadius="5" />
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="R" Foreground="#E8E8E8" VerticalAlignment="Center" />
            <Slider x:Name="RSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="55"
                    ValueChanged="Slider_Changed" VerticalAlignment="Center" />
            <TextBlock x:Name="RValue" Grid.Column="2" Foreground="#C8C8C8" TextAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="G" Foreground="#E8E8E8" VerticalAlignment="Center" />
            <Slider x:Name="GSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="214"
                    ValueChanged="Slider_Changed" VerticalAlignment="Center" />
            <TextBlock x:Name="GValue" Grid.Column="2" Foreground="#C8C8C8" TextAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="B" Foreground="#E8E8E8" VerticalAlignment="Center" />
            <Slider x:Name="BSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="192"
                    ValueChanged="Slider_Changed" VerticalAlignment="Center" />
            <TextBlock x:Name="BValue" Grid.Column="2" Foreground="#C8C8C8" TextAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>

        <TextBox x:Name="HexBox" Grid.Row="4" Style="{StaticResource InputBox}" Margin="0,12,0,0"
                 Text="#37D6C0" FontFamily="Consolas" PreviewKeyDown="HexBox_PreviewKeyDown"
                 LostKeyboardFocus="HexBox_LostKeyboardFocus" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource ToolButton}" Content="取消" Padding="16,6" Click="Cancel_Click" />
            <Button Style="{StaticResource AccentButton}" Content="确定" Padding="18,6" Margin="8,0,0,0" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
