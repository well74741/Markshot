<Window x:Class="Markshot.UI.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" Height="190"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#FF1C1C1C"
        FontFamily="Microsoft YaHei UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Text="名称" Foreground="#C8C8C8" FontSize="13" Margin="0,0,0,8" />

        <TextBox x:Name="ValueBox" Grid.Row="1" Style="{StaticResource InputBox}" FontSize="14" MaxLength="32" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource ToolButton}" Click="Cancel_Click" IsCancel="True" />
            <Button Content="确定" Style="{StaticResource AccentButton}" Click="Ok_Click" IsDefault="True" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
