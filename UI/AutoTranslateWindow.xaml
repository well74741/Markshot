<Window x:Class="Markshot.UI.AutoTranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Markshot 自动翻译"
        Width="1000" Height="700" MinWidth="760" MinHeight="520"
        Background="#FF1C1C1C"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        PreviewKeyDown="OnPreviewKeyDown"
        FontFamily="Microsoft YaHei UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="自动翻译" FontSize="18" Foreground="#F5F5F5" FontWeight="SemiBold" />
                <TextBlock Text="识别文字后原位替换，保留背景、字号与颜色" FontSize="12" Foreground="#8A8A8A"
                           VerticalAlignment="Bottom" Margin="8,0,0,2" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="正在识别文字…" Foreground="#6BA1FF" FontSize="12"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Background="#FF111111" BorderBrush="#33FFFFFF" BorderThickness="1"
                CornerRadius="6" ClipToBounds="True">
            <Grid>
                <Image x:Name="Preview" Stretch="Uniform" SnapsToDevicePixels="True" />
                <Border x:Name="BusyPanel" Background="#B0000000">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="正在翻译…" Foreground="#F5F5F5" FontSize="16"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="AI 正在逐行生成译文，请稍候" Foreground="#A8A8A8" FontSize="12"
                                   Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="HintText" Text="译文会覆盖原文字位置，可复制、保存或贴到屏幕。"
                       Foreground="#8A8A8A" FontSize="12" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="复制图片" Style="{StaticResource ToolButton}" Click="Copy_Click" />
                <Button Content="保存图片" Style="{StaticResource ToolButton}" Click="Save_Click" Margin="8,0,0,0" />
                <Button Content="贴图" Style="{StaticResource AccentButton}" Click="Pin_Click" Margin="8,0,0,0" />
                <Button Content="关闭" Style="{StaticResource ToolButton}" Click="Close_Click" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
