<UserControl x:Class="Markshot.UI.AnnotationToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Markshot.Core"
             Focusable="False">

    <Border Background="{DynamicResource T_F21E1E1E}" BorderBrush="{DynamicResource T_33FFFFFF}" BorderThickness="1" CornerRadius="9" Padding="5,3">
        <StackPanel>
            <StackPanel x:Name="MainRow" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="DragHandle" Width="20" Height="28" Background="Transparent"
                        Cursor="SizeAll" ToolTip="拖动工具栏"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                        MouseMove="DragHandle_MouseMove"
                        MouseLeftButtonUp="DragHandle_MouseLeftButtonUp">
                    <TextBlock Text="⠿" Foreground="{DynamicResource T_FF8A8A8A}" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel x:Name="ToolItems" Orientation="Horizontal">
                <RadioButton x:Name="ToolShape" Style="{StaticResource IconToolRadio}"
                             Tag="Rectangle" GroupName="Tool" Click="Tool_Click" ToolTip="图形：矩形/椭圆">
                    <Border x:Name="ToolShapeIcon" Style="{StaticResource IconRectMask}" />
                </RadioButton>
                <Button Style="{StaticResource ChevronButton}" Click="ShapeMenu_Click" ToolTip="图形样式" x:Name="ShapeChevron">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevron}" Width="10" Height="10" />
                </Button>

                <RadioButton x:Name="ToolPen" Style="{StaticResource IconToolRadio}"
                             Tag="Pen" GroupName="Tool" Click="Tool_Click" ToolTip="画笔/荧光笔 (B)">
                    <Border x:Name="ToolPenIcon" Style="{StaticResource IconPenMask}" />
                </RadioButton>
                <Button Style="{StaticResource ChevronButton}" Click="PenMenu_Click" ToolTip="画笔样式" x:Name="PenChevron">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevron}" Width="10" Height="10" />
                </Button>

                <RadioButton x:Name="ToolArrow" Style="{StaticResource IconToolRadio}"
                             Tag="Arrow" GroupName="Tool" Click="Tool_Click" ToolTip="箭头/直线 (L)">
                    <Border x:Name="ToolArrowIcon" Style="{StaticResource IconArrowMask}" />
                </RadioButton>
                <Button Style="{StaticResource ChevronButton}" Click="ArrowMenu_Click" ToolTip="箭头样式" x:Name="ArrowChevron">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevron}" Width="10" Height="10" />
                </Button>

                <RadioButton x:Name="ToolText" Style="{StaticResource IconToolRadio}"
                             Tag="Text" GroupName="Tool" Click="Tool_Click" ToolTip="文字 (T) / 水印">
                    <Border x:Name="ToolTextIcon" Style="{StaticResource IconTextMask}" />
                </RadioButton>
                <Button Style="{StaticResource ChevronButton}" Click="TextMenu_Click" ToolTip="文字 / 水印" x:Name="TextChevron">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevron}" Width="10" Height="10" />
                </Button>

                <RadioButton x:Name="ToolNumber" Style="{StaticResource IconToolRadio}"
                             Tag="Number" GroupName="Tool" Click="Tool_Click" ToolTip="序号 (S)">
                    <Border Style="{StaticResource IconNumberMask}" />
                </RadioButton>

                <RadioButton x:Name="ToolMosaic" Style="{StaticResource IconToolRadio}"
                             Tag="Mosaic" GroupName="Tool" Click="Tool_Click" ToolTip="马赛克（区域 / 画笔）">
                    <Border x:Name="ToolMosaicIcon" Style="{StaticResource IconMosaicMask}" />
                </RadioButton>
                <Button Style="{StaticResource ChevronButton}" Click="MosaicMenu_Click" ToolTip="马赛克样式" x:Name="MosaicChevron">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevron}" Width="10" Height="10" />
                </Button>

                <RadioButton x:Name="ToolEraser" Style="{StaticResource IconToolRadio}"
                             Tag="Eraser" GroupName="Tool" Click="Tool_Click" ToolTip="橡皮擦 (E) / 抠除">
                    <Border x:Name="ToolEraserIcon" Style="{StaticResource IconEraserMask}" />
                </RadioButton>
                <Button Style="{StaticResource ChevronButton}" Click="EraserMenu_Click" ToolTip="橡皮擦样式" x:Name="EraserChevron">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevron}" Width="10" Height="10" />
                </Button>
                </StackPanel>

                <Border Width="1" Height="18" Background="{DynamicResource T_33FFFFFF}" Margin="6,0" />

                <Button x:Name="UndoButton" Style="{StaticResource IconToolButton}" Click="Undo_Click" ToolTip="撤销 (Ctrl+Z)">
                    <Border Style="{StaticResource IconUndoMask}" />
                </Button>

                <Border Width="1" Height="18" Background="{DynamicResource T_33FFFFFF}" Margin="6,0" />

                <StackPanel x:Name="CaptureActions" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Tag="Scroll" Background="Transparent">
                        <Button x:Name="ScrollButton" Style="{StaticResource IconToolButton}" Click="Scroll_Click" ToolTip="长截图：滚动框内内容，自动拼接成长图（▾ 选择竖向 / 横向）">
                            <Border x:Name="ScrollIcon" Style="{StaticResource IconScrollMask}" />
                        </Button>
                        <Button x:Name="ScrollChevron" Style="{StaticResource ChevronButton}" Click="ScrollMenu_Click" ToolTip="长截图方向">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevron}" Width="10" Height="10" />
                        </Button>
                    </StackPanel>
                    <Button Style="{StaticResource IconToolButton}" Click="Record_Click" Tag="Record" ToolTip="录屏：录制这个区域">
                        <Border Style="{StaticResource IconRecordMask}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Ocr_Click" Tag="Ocr" ToolTip="文字识别">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconOcr}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Close_Click" Tag="Close" ToolTip="关闭 (Esc)">
                        <Border Style="{StaticResource IconCloseMask}" />
                    </Button>
                    <Button x:Name="ClearCaptureButton" Style="{StaticResource IconToolButton}" Click="Clear_Click" Tag="Clear" ToolTip="清空批注（可撤销）" IsEnabled="False">
                        <Border Style="{StaticResource IconTrashMask}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Pin_Click" Tag="Pin" ToolTip="贴图 (F3)" Foreground="{StaticResource Accent}">
                        <Border Style="{StaticResource IconPinMask}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Save_Click" Tag="Save" ToolTip="保存 (Ctrl+S)">
                        <Border Style="{StaticResource IconSaveMask}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Copy_Click" Tag="Copy" ToolTip="复制 (Enter)">
                        <Border Style="{StaticResource IconCopyMask}" />
                    </Button>
                    <ToggleButton x:Name="TranslateToggle" Style="{StaticResource IconToolToggle}"
                                  Click="TranslateToggle_Click" Tag="Translate"
                                  ToolTip="原位翻译：像浏览器一样把选区里的文字直接替换成译文（开关会被记住）">
                        <Border Style="{StaticResource IconTranslateMask}" />
                    </ToggleButton>
                    <Button Style="{StaticResource IconToolButton}" Click="Edit_Click" Tag="Edit" ToolTip="在图片编辑器里打开">
                        <Border Style="{StaticResource IconEditMask}" />
                    </Button>
                </StackPanel>

                <StackPanel x:Name="PinActions" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Style="{StaticResource IconToolButton}" Click="Close_Click" Tag="Close" ToolTip="关闭贴图">
                        <Border Style="{StaticResource IconCloseMask}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Save_Click" Tag="Save" ToolTip="保存">
                        <Border Style="{StaticResource IconSaveMask}" />
                    </Button>
                    <Button x:Name="ClearPinButton" Style="{StaticResource IconToolButton}" Click="Clear_Click" Tag="Clear" ToolTip="清空批注（可撤销）" IsEnabled="False">
                        <Border Style="{StaticResource IconTrashMask}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Apply_Click" Tag="Apply" ToolTip="应用 (Ctrl+S)" Foreground="{StaticResource Accent}">
                        <Border Style="{StaticResource IconConfirmMask}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Edit_Click" Tag="Edit" ToolTip="在图片编辑器里打开">
                        <Border Style="{StaticResource IconEditMask}" />
                    </Button>
                </StackPanel>

                <!-- The image editor: open, save, copy and pin. -->
                <StackPanel x:Name="EditorActions" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Style="{StaticResource IconToolButton}" Click="Open_Click" Tag="Open" ToolTip="打开图片 (Ctrl+O)">
                        <Border Style="{StaticResource IconOpenMask}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Save_Click" Tag="Save" ToolTip="保存 (Ctrl+S)">
                        <Border Style="{StaticResource IconSaveMask}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Copy_Click" Tag="Copy" ToolTip="复制 (Ctrl+C)">
                        <Border Style="{StaticResource IconCopyMask}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Pin_Click" Tag="Pin" ToolTip="贴到屏幕 (Ctrl+T)" Foreground="{StaticResource Accent}">
                        <Border Style="{StaticResource IconPinMask}" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <!-- The settings row slides open / closed and eases its width (SizeTransitionHost). -->
            <core:SizeTransitionHost x:Name="SettingsHost">
            <Border x:Name="SettingsBar" BorderBrush="{DynamicResource T_26FFFFFF}" BorderThickness="0,1,0,0"
                    Margin="0,3,0,0" Padding="2,3,0,0">
                <!-- Same height for every tool's row. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="32">
                    <!-- The eraser's two styles: 擦除 (annotations) / 抠除 (a transparent hole through everything). -->
                    <StackPanel x:Name="EraserModes" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="EraserErase" Style="{StaticResource IconToolRadio}" Tag="Eraser" GroupName="Variant" Checked="Variant_Checked" ToolTip="擦除：擦掉批注（Tab 切换）">
                            <Border Style="{StaticResource IconEraserMask}" />
                        </RadioButton>
                        <RadioButton x:Name="EraserCut" Style="{StaticResource IconToolRadio}" Tag="Cutout" GroupName="Variant" Checked="Variant_Checked" ToolTip="抠除：连同图片和所有批注一起擦成透明，之后画的批注也不会盖住空洞（Tab 切换）">
                            <Border Style="{StaticResource IconCutoutMask}" />
                        </RadioButton>
                    </StackPanel>

                    <StackPanel x:Name="RectVariants" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="VariantRect" Style="{StaticResource IconToolRadio}" Tag="Rectangle" GroupName="Variant" Checked="Variant_Checked" ToolTip="矩形">
                            <Border Style="{StaticResource IconRectMask}" />
                        </RadioButton>
                        <RadioButton x:Name="VariantEllipse" Style="{StaticResource IconToolRadio}" Tag="Ellipse" GroupName="Variant" Checked="Variant_Checked" ToolTip="椭圆">
                            <Border Style="{StaticResource IconEllipseMask}" />
                        </RadioButton>
                    </StackPanel>

                    <StackPanel x:Name="LineVariants" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="VariantLine" Style="{StaticResource IconToolRadio}" Tag="Line" GroupName="Variant" Checked="Variant_Checked" ToolTip="直线">
                            <Border Style="{StaticResource IconLineMask}" />
                        </RadioButton>
                        <RadioButton x:Name="VariantArrow" Style="{StaticResource IconToolRadio}" Tag="Arrow" GroupName="Variant" Checked="Variant_Checked" ToolTip="箭头">
                            <Border Style="{StaticResource IconArrowMask}" />
                        </RadioButton>
                        <RadioButton x:Name="VariantPolyline" Style="{StaticResource IconToolRadio}" Tag="Polyline" GroupName="Variant" Checked="Variant_Checked"
                                     ToolTip="折线：单击放拐点，双击 / Enter / 右键结束，Backspace 撤回一个拐点，Shift 45°">
                            <Border Style="{StaticResource IconPolylineMask}" />
                        </RadioButton>
                    </StackPanel>

                    <!-- Arrow heads (a small style of the arrow; Tab only switches 箭头 / 直线). -->
                    <StackPanel x:Name="ArrowStyleGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="样式" Foreground="{DynamicResource T_FFA8A8A8}" FontSize="11" VerticalAlignment="Center" Margin="6,0,6,0" />
                        <Border Background="{DynamicResource T_FF2A2A2A}" CornerRadius="5" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ArrowSharp" Style="{StaticResource SegmentRadio}" Tag="Sharp" GroupName="ArrowStyle" Checked="ArrowStyle_Checked" Content="尖头" ToolTip="尖头箭头" />
                                <RadioButton x:Name="ArrowOpen" Style="{StaticResource SegmentRadio}" Tag="Open" GroupName="ArrowStyle" Checked="ArrowStyle_Checked" Content="线形" ToolTip="线形箭头" />
                                <RadioButton x:Name="ArrowTriangle" Style="{StaticResource SegmentRadio}" Tag="Triangle" GroupName="ArrowStyle" Checked="ArrowStyle_Checked" Content="三角" ToolTip="三角箭头" />
                                <RadioButton x:Name="ArrowDouble" Style="{StaticResource SegmentRadio}" Tag="Double" GroupName="ArrowStyle" Checked="ArrowStyle_Checked" Content="双向" ToolTip="双向箭头" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PenVariants" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="VariantPen" Style="{StaticResource IconToolRadio}" Tag="Pen" GroupName="Variant" Checked="Variant_Checked" ToolTip="画笔">
                            <Border Style="{StaticResource IconPenMask}" />
                        </RadioButton>
                        <RadioButton x:Name="VariantHighlighter" Style="{StaticResource IconToolRadio}" Tag="Highlighter" GroupName="Variant" Checked="Variant_Checked" ToolTip="荧光笔">
                            <Border Style="{StaticResource IconHighlighterMask}" />
                        </RadioButton>
                    </StackPanel>

                    <!-- The text button's two styles: 文字 / 水印 (also in its ▾ menu and with Tab). -->
                    <StackPanel x:Name="TextVariants" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="VariantText" Style="{StaticResource IconToolRadio}" Tag="Text" GroupName="Variant" Checked="Variant_Checked" ToolTip="文字">
                            <Border Style="{StaticResource IconTextMask}" />
                        </RadioButton>
                        <RadioButton x:Name="VariantWatermark" Style="{StaticResource IconToolRadio}" Tag="Watermark" GroupName="Variant" Checked="Variant_Checked" ToolTip="水印">
                            <Border Style="{StaticResource IconWatermarkMask}" />
                        </RadioButton>
                    </StackPanel>

                    <StackPanel x:Name="WatermarkGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Width="1" Height="18" Background="{DynamicResource T_33FFFFFF}" Margin="6,0" />
                        <ToggleButton x:Name="WatermarkToggle" Style="{StaticResource ToolToggle}" Content="开启"
                                      Click="WatermarkToggle_Click" ToolTip="水印开关：关闭即去掉水印（可撤销）" />
                    </StackPanel>

                    <StackPanel x:Name="MosaicVariants" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="类型" Foreground="{DynamicResource T_FFA8A8A8}" FontSize="11" VerticalAlignment="Center" Margin="4,0,6,0" />
                        <Border Background="{DynamicResource T_FF2A2A2A}" CornerRadius="5" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="VariantMosaic" Style="{StaticResource SegmentRadio}" Tag="Mosaic" GroupName="Variant"
                                             Checked="Variant_Checked" Content="区域" ToolTip="框选区域打码" />
                                <RadioButton x:Name="VariantMosaicBrush" Style="{StaticResource SegmentRadio}" Tag="MosaicBrush" GroupName="Variant"
                                             Checked="Variant_Checked" Content="画笔" ToolTip="涂抹打码（Shift 画直线）" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ToggleButton x:Name="FillToggle" Style="{StaticResource ToolToggle}" Content="填充"
                                  Click="Fill_Click" ToolTip="填充图形" />

                    <StackPanel x:Name="WidthGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <Border x:Name="WidthSeparator" Width="1" Height="18" Background="{DynamicResource T_33FFFFFF}" Margin="6,0" />
                        <TextBlock x:Name="WidthLabel" Text="粗细" Foreground="{DynamicResource T_FFA8A8A8}" FontSize="11" VerticalAlignment="Center" />
                        <Slider x:Name="WidthSlider" Focusable="False" IsMoveToPointEnabled="True" Width="86" Minimum="1" Maximum="16" Value="3"
                                ValueChanged="Width_Changed" VerticalAlignment="Center" Margin="5,0,2,0" />
                        <TextBlock x:Name="WidthValue" Text="3" Foreground="{DynamicResource T_FFC8C8C8}" FontSize="11" Width="20"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="CornerGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Width="1" Height="18" Background="{DynamicResource T_33FFFFFF}" Margin="5,0" />
                        <TextBlock Text="圆角" Foreground="{DynamicResource T_FFA8A8A8}" FontSize="11" VerticalAlignment="Center" />
                        <Slider x:Name="CornerSlider" Focusable="False" IsMoveToPointEnabled="True" Width="64" Minimum="0" Maximum="40" Value="0"
                                ValueChanged="Corner_Changed" VerticalAlignment="Center" Margin="5,0,2,0" />
                        <TextBlock x:Name="CornerValue" Text="0" Foreground="{DynamicResource T_FFC8C8C8}" FontSize="11" Width="20"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="LevelGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Width="1" Height="18" Background="{DynamicResource T_33FFFFFF}" Margin="6,0" />
                        <TextBlock Text="程度" Foreground="{DynamicResource T_FFA8A8A8}" FontSize="11" VerticalAlignment="Center" />
                        <Slider x:Name="LevelSlider" Focusable="False" IsMoveToPointEnabled="True" Width="86" Minimum="4" Maximum="40" Value="12"
                                ValueChanged="Level_Changed" VerticalAlignment="Center" Margin="5,0,2,0" />
                        <TextBlock x:Name="LevelValue" Text="12" Foreground="{DynamicResource T_FFC8C8C8}" FontSize="11" Width="20"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="AngleGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Width="1" Height="18" Background="{DynamicResource T_33FFFFFF}" Margin="6,0" />
                        <TextBlock Text="倾斜" Foreground="{DynamicResource T_FFA8A8A8}" FontSize="11" VerticalAlignment="Center" />
                        <Slider x:Name="AngleSlider" Focusable="False" IsMoveToPointEnabled="True" Width="80" Minimum="-60" Maximum="60" Value="-24"
                                ValueChanged="Angle_Changed" VerticalAlignment="Center" Margin="5,0,2,0" />
                        <TextBlock x:Name="AngleValue" Text="-24°" Foreground="{DynamicResource T_FFC8C8C8}" FontSize="11" Width="30"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="OpacityGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Width="1" Height="18" Background="{DynamicResource T_33FFFFFF}" Margin="6,0" />
                        <TextBlock Text="透明度" Foreground="{DynamicResource T_FFA8A8A8}" FontSize="11" VerticalAlignment="Center" />
                        <Slider x:Name="OpacitySlider" Focusable="False" IsMoveToPointEnabled="True" Width="80" Minimum="5" Maximum="100" Value="25"
                                ValueChanged="Opacity_Changed" VerticalAlignment="Center" Margin="5,0,2,0" />
                        <TextBlock x:Name="OpacityValue" Text="25%" Foreground="{DynamicResource T_FFC8C8C8}" FontSize="11" Width="30"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="TextStyleGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Width="1" Height="18" Background="{DynamicResource T_33FFFFFF}" Margin="6,0" />
                        <ToggleButton x:Name="BoldToggle" Style="{StaticResource ToolToggle}" Padding="8,5"
                                      Click="TextStyle_Click" ToolTip="粗体 (Ctrl+B)">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="13" />
                        </ToggleButton>
                        <ToggleButton x:Name="ItalicToggle" Style="{StaticResource ToolToggle}" Padding="8,5"
                                      Click="TextStyle_Click" ToolTip="倾斜 (Ctrl+I)">
                            <TextBlock Text="I" FontStyle="Italic" FontWeight="SemiBold" FontSize="13" FontFamily="Georgia" />
                        </ToggleButton>
                        <ToggleButton x:Name="BackgroundToggle" Style="{StaticResource ToolToggle}" Content="背景"
                                      Click="TextStyle_Click" ToolTip="文字底色：以当前颜色作标签底，文字自动用反差色" />
                    </StackPanel>

                    <StackPanel x:Name="StrokeGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Width="1" Height="18" Background="{DynamicResource T_33FFFFFF}" Margin="6,0" />
                        <TextBlock Text="描边" Foreground="{DynamicResource T_FFA8A8A8}" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"
                                   ToolTip="文字描边：粗细为 0 即关闭" />
                        <Button x:Name="StrokeColorButton" Style="{StaticResource IconToolButton}"
                                Click="StrokeColor_Click" ToolTip="描边颜色">
                            <Ellipse x:Name="StrokeColorCircle" Width="16" Height="16" Fill="#FFFFFF"
                                     Stroke="{DynamicResource T_FFD8D8D8}" StrokeThickness="1.2" />
                        </Button>
                        <Slider x:Name="StrokeSlider" Focusable="False" IsMoveToPointEnabled="True" Width="56" Minimum="0" Maximum="8" Value="0"
                                ValueChanged="Stroke_Changed" VerticalAlignment="Center" Margin="4,0,2,0" />
                        <TextBlock x:Name="StrokeValue" Text="0" Foreground="{DynamicResource T_FFC8C8C8}" FontSize="11" Width="16"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="ColorSection" Orientation="Horizontal">
                        <Border Width="1" Height="18" Background="{DynamicResource T_33FFFFFF}" Margin="6,0" />
                        <StackPanel x:Name="ColorGroup" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CustomColorButton" Style="{StaticResource IconToolButton}" Click="CustomColor_Click" ToolTip="自定义颜色">
                                <!-- Same size as the palette swatches (20px) plus a 3px rainbow ring outside. -->
                                <Grid Width="26" Height="26">
                                    <Ellipse Width="26" Height="26">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF4D4F" Offset="0" />
                                                <GradientStop Color="#FFD166" Offset="0.2" />
                                                <GradientStop Color="#52C41A" Offset="0.4" />
                                                <GradientStop Color="#00E5E5" Offset="0.6" />
                                                <GradientStop Color="#4C8DFF" Offset="0.8" />
                                                <GradientStop Color="#B37FEB" Offset="1" />
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="22" Height="22" Fill="{DynamicResource T_FF1E1E1E}" />
                                    <!-- Checkerboard under the preview shows the current opacity. -->
                                    <Ellipse Width="20" Height="20" Fill="{StaticResource SmallCheckerBrush}" />
                                    <Ellipse x:Name="CustomColorInner" Width="20" Height="20"
                                             Stroke="{DynamicResource T_5AFFFFFF}" StrokeThickness="1" />
                                </Grid>
                            </Button>
                            <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                            <TextBlock x:Name="OpacityHint" Foreground="{DynamicResource T_FFC8C8C8}" FontSize="11" VerticalAlignment="Center"
                                       Margin="4,0,2,0" Visibility="Collapsed" ToolTip="透明度：Ctrl+滚轮调整" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            </core:SizeTransitionHost>
        </StackPanel>
    </Border>
</UserControl>
