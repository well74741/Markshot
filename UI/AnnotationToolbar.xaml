<UserControl x:Class="Markshot.UI.AnnotationToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <Border Background="#F21E1E1E" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="9" Padding="5,3">
        <StackPanel>
            <StackPanel x:Name="MainRow" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="DragHandle" Width="20" Height="28" Background="Transparent"
                        Cursor="SizeAll" ToolTip="拖动工具栏"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                        MouseMove="DragHandle_MouseMove"
                        MouseLeftButtonUp="DragHandle_MouseLeftButtonUp">
                    <TextBlock Text="⠿" Foreground="#8A8A8A" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel x:Name="ToolItems" Orientation="Horizontal">
                <RadioButton x:Name="ToolShape" Style="{StaticResource IconToolRadio}"
                             Tag="Rectangle" GroupName="Tool" Click="Tool_Click" ToolTip="图形：矩形/椭圆">
                    <Border Style="{StaticResource IconRectMask}" />
                </RadioButton>
                <Button Style="{StaticResource ChevronButton}" Click="ShapeMenu_Click" ToolTip="图形样式" x:Name="ShapeChevron">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevron}" Width="10" Height="10" />
                </Button>

                <RadioButton x:Name="ToolPen" Style="{StaticResource IconToolRadio}"
                             Tag="Pen" GroupName="Tool" Click="Tool_Click" ToolTip="画笔/荧光笔 (B)">
                    <Border Style="{StaticResource IconPenMask}" />
                </RadioButton>
                <Button Style="{StaticResource ChevronButton}" Click="PenMenu_Click" ToolTip="画笔样式" x:Name="PenChevron">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevron}" Width="10" Height="10" />
                </Button>

                <RadioButton x:Name="ToolArrow" Style="{StaticResource IconToolRadio}"
                             Tag="Arrow" GroupName="Tool" Click="Tool_Click" ToolTip="箭头/直线 (L)">
                    <Border Style="{StaticResource IconArrowMask}" />
                </RadioButton>
                <Button Style="{StaticResource ChevronButton}" Click="ArrowMenu_Click" ToolTip="箭头样式" x:Name="ArrowChevron">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevron}" Width="10" Height="10" />
                </Button>

                <RadioButton x:Name="ToolText" Style="{StaticResource IconToolRadio}"
                             Tag="Text" GroupName="Tool" Click="Tool_Click" ToolTip="文字 (T)">
                    <Border Style="{StaticResource IconTextMask}" />
                </RadioButton>
                <Button Style="{StaticResource ChevronButton}" Click="TextMenu_Click" ToolTip="文字字号" x:Name="TextChevron">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevron}" Width="10" Height="10" />
                </Button>

                <RadioButton x:Name="ToolNumber" Style="{StaticResource IconToolRadio}"
                             Tag="Number" GroupName="Tool" Click="Tool_Click" ToolTip="序号 (S)">
                    <Border Style="{StaticResource IconNumberMask}" />
                </RadioButton>

                <RadioButton x:Name="ToolMosaic" Style="{StaticResource IconToolRadio}"
                             Tag="Mosaic" GroupName="Tool" Click="Tool_Click" ToolTip="马赛克/水印">
                    <Border Style="{StaticResource IconMosaicMask}" />
                </RadioButton>
                <Button Style="{StaticResource ChevronButton}" Click="MosaicMenu_Click" ToolTip="马赛克样式" x:Name="MosaicChevron">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevron}" Width="10" Height="10" />
                </Button>

                <RadioButton x:Name="ToolEraser" Style="{StaticResource IconToolRadio}"
                             Tag="Eraser" GroupName="Tool" Click="Tool_Click" ToolTip="橡皮擦 (E)">
                    <Border Style="{StaticResource IconEraserMask}" />
                </RadioButton>
                </StackPanel>

                <Border Width="1" Height="18" Background="#33FFFFFF" Margin="6,0" />

                <Button x:Name="UndoButton" Style="{StaticResource IconToolButton}" Click="Undo_Click" ToolTip="撤销 (Ctrl+Z)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconUndo}" />
                </Button>

                <Border Width="1" Height="18" Background="#33FFFFFF" Margin="6,0" />

                <StackPanel x:Name="CaptureActions" Orientation="Horizontal">
                    <Button Style="{StaticResource IconToolButton}" Click="Ocr_Click" ToolTip="文字识别">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconOcr}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Close_Click" ToolTip="关闭 (Esc)">
                        <Border Style="{StaticResource IconCloseMask}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Pin_Click" ToolTip="贴图 (F3)" Foreground="{StaticResource Accent}">
                        <Border Style="{StaticResource IconPinMask}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Save_Click" ToolTip="保存 (Ctrl+S)">
                        <Border Style="{StaticResource IconSaveMask}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Copy_Click" ToolTip="复制 (Enter)">
                        <Border Style="{StaticResource IconCopyMask}" />
                    </Button>
                    <ToggleButton x:Name="TranslateToggle" Style="{StaticResource IconToolToggle}"
                                  Click="TranslateToggle_Click"
                                  ToolTip="原位翻译：像浏览器一样把选区里的文字直接替换成译文（开关会被记住）">
                        <Border Style="{StaticResource IconTranslateMask}" />
                    </ToggleButton>
                </StackPanel>

                <StackPanel x:Name="PinActions" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Style="{StaticResource IconToolButton}" Click="Save_Click" ToolTip="保存">
                        <Border Style="{StaticResource IconSaveMask}" />
                    </Button>
                    <Button Style="{StaticResource IconToolButton}" Click="Apply_Click" ToolTip="应用 (Ctrl+S)" Foreground="{StaticResource Accent}">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCheck}" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <Border x:Name="SettingsBar" Visibility="Collapsed" BorderBrush="#26FFFFFF" BorderThickness="0,1,0,0"
                    Margin="0,3,0,0" Padding="2,3,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="RectVariants" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="VariantRect" Style="{StaticResource IconToolRadio}" Tag="Rectangle" GroupName="Variant" Checked="Variant_Checked" ToolTip="矩形">
                            <Border Style="{StaticResource IconRectMask}" />
                        </RadioButton>
                        <RadioButton x:Name="VariantEllipse" Style="{StaticResource IconToolRadio}" Tag="Ellipse" GroupName="Variant" Checked="Variant_Checked" ToolTip="椭圆">
                            <Border Style="{StaticResource IconEllipseMask}" />
                        </RadioButton>
                    </StackPanel>

                    <StackPanel x:Name="LineVariants" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="VariantLine" Style="{StaticResource IconToolRadio}" Tag="Line" GroupName="Variant" Checked="Variant_Checked" ToolTip="直线">
                            <Border Style="{StaticResource IconLineMask}" />
                        </RadioButton>
                        <RadioButton x:Name="VariantArrow" Style="{StaticResource IconToolRadio}" Tag="Arrow" GroupName="Variant" Checked="Variant_Checked" ToolTip="箭头">
                            <Border Style="{StaticResource IconArrowMask}" />
                        </RadioButton>
                    </StackPanel>

                    <StackPanel x:Name="PenVariants" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="VariantPen" Style="{StaticResource IconToolRadio}" Tag="Pen" GroupName="Variant" Checked="Variant_Checked" ToolTip="画笔">
                            <Border Style="{StaticResource IconPenMask}" />
                        </RadioButton>
                        <RadioButton x:Name="VariantHighlighter" Style="{StaticResource IconToolRadio}" Tag="Highlighter" GroupName="Variant" Checked="Variant_Checked" ToolTip="荧光笔">
                            <Border Style="{StaticResource IconHighlighterMask}" />
                        </RadioButton>
                    </StackPanel>

                    <StackPanel x:Name="MosaicVariants" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="VariantMosaic" Style="{StaticResource IconToolRadio}" Tag="Mosaic" GroupName="Variant" Checked="Variant_Checked" ToolTip="框选马赛克">
                            <Border Style="{StaticResource IconMosaicMask}" />
                        </RadioButton>
                        <RadioButton x:Name="VariantMosaicBrush" Style="{StaticResource IconToolRadio}" Tag="MosaicBrush" GroupName="Variant" Checked="Variant_Checked" ToolTip="笔刷马赛克（Shift 画直线）">
                            <Grid Width="18" Height="18">
                                <Border Style="{StaticResource IconMosaicMask}" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Ellipse Width="7" Height="7" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="VariantWatermark" Style="{StaticResource IconToolRadio}" Tag="Watermark" GroupName="Variant" Checked="Variant_Checked" ToolTip="水印">
                            <Border Style="{StaticResource IconWatermarkMask}" />
                        </RadioButton>
                    </StackPanel>

                    <ToggleButton x:Name="FillToggle" Style="{StaticResource ToolToggle}" Content="填充"
                                  Click="Fill_Click" ToolTip="填充图形" />

                    <StackPanel x:Name="WidthGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <Border x:Name="WidthSeparator" Width="1" Height="18" Background="#33FFFFFF" Margin="6,0" />
                        <TextBlock x:Name="WidthLabel" Text="粗细" Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center" />
                        <Slider x:Name="WidthSlider" Focusable="False" IsMoveToPointEnabled="True" Width="86" Minimum="1" Maximum="16" Value="3"
                                ValueChanged="Width_Changed" VerticalAlignment="Center" Margin="5,0,2,0" />
                        <TextBlock x:Name="WidthValue" Text="3" Foreground="#C8C8C8" FontSize="11" Width="20"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="CornerGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Width="1" Height="18" Background="#33FFFFFF" Margin="5,0" />
                        <TextBlock Text="圆角" Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center" />
                        <Slider x:Name="CornerSlider" Focusable="False" IsMoveToPointEnabled="True" Width="64" Minimum="0" Maximum="40" Value="0"
                                ValueChanged="Corner_Changed" VerticalAlignment="Center" Margin="5,0,2,0" />
                        <TextBlock x:Name="CornerValue" Text="0" Foreground="#C8C8C8" FontSize="11" Width="20"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="LevelGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Width="1" Height="18" Background="#33FFFFFF" Margin="6,0" />
                        <TextBlock Text="程度" Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center" />
                        <Slider x:Name="LevelSlider" Focusable="False" IsMoveToPointEnabled="True" Width="86" Minimum="4" Maximum="40" Value="12"
                                ValueChanged="Level_Changed" VerticalAlignment="Center" Margin="5,0,2,0" />
                        <TextBlock x:Name="LevelValue" Text="12" Foreground="#C8C8C8" FontSize="11" Width="20"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="OpacityGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Width="1" Height="18" Background="#33FFFFFF" Margin="6,0" />
                        <TextBlock Text="透明度" Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center" />
                        <Slider x:Name="OpacitySlider" Focusable="False" IsMoveToPointEnabled="True" Width="80" Minimum="5" Maximum="100" Value="25"
                                ValueChanged="Opacity_Changed" VerticalAlignment="Center" Margin="5,0,2,0" />
                        <TextBlock x:Name="OpacityValue" Text="25%" Foreground="#C8C8C8" FontSize="11" Width="30"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="TextStyleGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Width="1" Height="18" Background="#33FFFFFF" Margin="6,0" />
                        <ToggleButton x:Name="BoldToggle" Style="{StaticResource ToolToggle}" Padding="8,5"
                                      Click="TextStyle_Click" ToolTip="粗体 (Ctrl+B)">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="13" />
                        </ToggleButton>
                        <ToggleButton x:Name="ItalicToggle" Style="{StaticResource ToolToggle}" Padding="8,5"
                                      Click="TextStyle_Click" ToolTip="倾斜 (Ctrl+I)">
                            <TextBlock Text="I" FontStyle="Italic" FontWeight="SemiBold" FontSize="13" FontFamily="Georgia" />
                        </ToggleButton>
                        <ToggleButton x:Name="BackgroundToggle" Style="{StaticResource ToolToggle}" Content="背景"
                                      Click="TextStyle_Click" ToolTip="文字底色：以当前颜色作标签底，文字自动用反差色" />
                    </StackPanel>

                    <StackPanel x:Name="StrokeGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Width="1" Height="18" Background="#33FFFFFF" Margin="6,0" />
                        <ToggleButton x:Name="StrokeToggle" Style="{StaticResource ToolToggle}" Content="描边"
                                      Click="Stroke_Click" ToolTip="文字描边（默认白色）" />
                        <Button x:Name="StrokeColorButton" Style="{StaticResource IconToolButton}"
                                Click="StrokeColor_Click" ToolTip="描边颜色">
                            <Ellipse x:Name="StrokeColorCircle" Width="16" Height="16" Fill="#FFFFFF"
                                     Stroke="#D8D8D8" StrokeThickness="1.2" />
                        </Button>
                        <Slider x:Name="StrokeSlider" Focusable="False" IsMoveToPointEnabled="True" Width="56" Minimum="0" Maximum="8" Value="0"
                                ValueChanged="Stroke_Changed" VerticalAlignment="Center" Margin="4,0,2,0" />
                        <TextBlock x:Name="StrokeValue" Text="0" Foreground="#C8C8C8" FontSize="11" Width="16"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="ColorSection" Orientation="Horizontal">
                        <Border Width="1" Height="18" Background="#33FFFFFF" Margin="6,0" />
                        <StackPanel x:Name="ColorGroup" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CustomColorButton" Style="{StaticResource IconToolButton}" Click="CustomColor_Click" ToolTip="自定义颜色">
                                <!-- Same size as the palette swatches (20px) plus a 3px rainbow ring outside. -->
                                <Grid Width="26" Height="26">
                                    <Ellipse Width="26" Height="26">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF4D4F" Offset="0" />
                                                <GradientStop Color="#FFD166" Offset="0.2" />
                                                <GradientStop Color="#52C41A" Offset="0.4" />
                                                <GradientStop Color="#00E5E5" Offset="0.6" />
                                                <GradientStop Color="#4C8DFF" Offset="0.8" />
                                                <GradientStop Color="#B37FEB" Offset="1" />
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="22" Height="22" Fill="#FF1E1E1E" />
                                    <Ellipse x:Name="CustomColorInner" Width="20" Height="20"
                                             Stroke="#5AFFFFFF" StrokeThickness="1" />
                                </Grid>
                            </Button>
                            <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
